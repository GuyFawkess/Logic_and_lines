---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/sections/SiteHeader.astro";
import HeroHome from "../components/sections/HeroHome.astro";
import MarqueeBand from "../components/sections/MarqueeBand.astro";
import Thesis from "../components/sections/Thesis.astro";
import ServicesIndex from "../components/sections/ServicesIndex.astro";
import ProcessRail from "../components/sections/ProcessRail.astro";
import Proof from "../components/sections/Proof.astro";
import FaqIndex from "../components/sections/FaqIndex.astro";
import BookingClose from "../components/sections/BookingClose.astro";
import SiteFooter from "../components/sections/SiteFooter.astro";

export const prerender = true;

const currentLang = "es";

// WebSite + Organization schemas para la home
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "url": "https://logicandlines.com/",
  "name": "Logic & Lines",
  "description": "Agencia de Marketing y Automatización con IA. Transformamos negocios mediante estrategias digitales avanzadas y automatización inteligente.",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://logicandlines.com/?s={search_term_string}",
    "query-input": "required name=search_term_string"
  }
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Logic & Lines",
  "url": "https://logicandlines.com/",
  "logo": "https://logicandlines.com/logoEntero.svg",
  "sameAs": [
    "https://www.instagram.com/logic_and_lines/?hl=en"
  ]
};
---

<Layout
	title="Agencia de Marketing y Automatización con IA"
	description="Logic & Lines: Agencia de Marketing y Automatización con IA. Transformamos negocios mediante estrategias digitales avanzadas y automatización inteligente."
	ogImage="/logoNoSub.svg"
	chrome={false}
>
	<!-- Schemas JSON-LD exclusivos de la home -->
	<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
	<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

	<!-- El H1 único de la página es el claim del hero (HeroHome) -->
	<SiteHeader currentLang={currentLang} />
	<main>
		<HeroHome currentLang={currentLang} />
		<MarqueeBand currentLang={currentLang} />
		<Thesis currentLang={currentLang} />
		<!-- Persiana line-native (F3-v2, USO ÚNICO): wrapper sin estilos; TODO lo
		     efímero lo crea shutter.ts solo con JS y viewport lg. Sin JS o en
		     móvil: flujo normal, cero overlays. -->
		<div data-shutter>
			<ServicesIndex currentLang={currentLang} />
		</div>
		<ProcessRail currentLang={currentLang} />
		<Proof currentLang={currentLang} />
		<FaqIndex currentLang={currentLang} />
		<BookingClose currentLang={currentLang} />
	</main>
	<SiteFooter currentLang={currentLang} />
</Layout>
