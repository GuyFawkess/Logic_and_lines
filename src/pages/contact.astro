---
// Contacto v4 (F1-SUBPAGES, Dirección C): composición asimétrica — copia ancha
// a la izquierda, canales en columna estrecha con hairlines a la derecha (sin
// cards ni iconos decorativos) y un tramo estático de la Línea Maestra que
// cierra en el CTA de Cal.com. El contenido, el JSON-LD ContactPage y todos los
// scripts de tracking se conservan tal cual (byte-idénticos en función).
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/sections/SiteHeader.astro";
import SiteFooter from "../components/sections/SiteFooter.astro";
import { useTranslations } from "../i18n/utils";

export const prerender = true;

const currentLang = "es";
const t = useTranslations(currentLang);

const pageTitle = t.seo.contactTitle;
const pageDescription = t.seo.contactDescription;
const fullTitle = `${pageTitle} | Logic & Lines`;
const canonicalURL = "https://logicandlines.com/contact";

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: fullTitle,
  url: canonicalURL,
  description: pageDescription,
  mainEntity: {
    "@type": "Organization",
    name: "Logic & Lines",
    email: "logicandlinestudios@gmail.com",
    url: "https://logicandlines.com",
    sameAs: ["https://www.instagram.com/logic_and_lines/?hl=en"],
  },
};
---

<Layout title={pageTitle} description={pageDescription} chrome={false}>
  <SiteHeader currentLang={currentLang} homePrefix="/" />
  <main>
    <section
      class="mx-auto w-full max-w-[1400px] px-6 pb-20 pt-20 lg:px-10 lg:pb-28 lg:pt-28"
    >
      <h1
        class="max-w-[14ch] font-display text-[clamp(2.5rem,6vw,5rem)] font-normal leading-[1.12] tracking-[-0.04em] text-(--color-text)"
        data-reveal="lines"
      >
        {t.contact.title}
      </h1>

      <div class="mt-16 grid grid-cols-1 gap-x-10 gap-y-16 md:grid-cols-12">
        <!-- Copia: ancha, a la izquierda -->
        <div class="md:col-span-7">
          <h2
            class="font-display text-xl leading-snug text-(--color-text) md:text-2xl"
            data-reveal="lines"
          >
            {t.contact.info}
          </h2>
          <h3
            class="mt-6 max-w-[22ch] font-display text-[clamp(1.75rem,3.2vw,2.75rem)] leading-[1.12] tracking-[-0.02em] text-(--color-text)"
          >
            {t.contact.thankYou}
          </h3>
          <p class="mt-8 max-w-[65ch] text-lg leading-relaxed text-(--color-text-dark)">
            {t.contact.preparation}
          </p>
          <p class="mt-6 max-w-[65ch] text-lg leading-relaxed text-(--color-text-dark)">
            {t.contact.offering}
          </p>
          <p class="mt-6 max-w-[65ch] text-lg leading-relaxed text-(--color-text-dark)">
            {t.contact.bookSession}
          </p>
          <p class="mt-6 max-w-[65ch] text-lg leading-relaxed text-(--color-text-dark)">
            {t.contact.lookForward}
          </p>
        </div>

        <!-- Canales: columna estrecha, apilados con hairlines (sin cards) -->
        <div class="md:col-span-4 md:col-start-9">
          <h2
            class="font-display text-xl leading-snug text-(--color-text) md:text-2xl"
            data-reveal="lines"
          >
            {t.contact.reachMe}
          </h2>
          <ul class="mt-8">
            <li class="border-t border-(--color-hairline)">
              <a
                href="https://wa.me/34628125302"
                target="_blank"
                rel="noopener noreferrer"
                class="flex min-h-11 items-center py-4 text-base text-(--color-text) transition-colors duration-200 hover:text-(--color-primary)"
                aria-label="Contáctanos por WhatsApp"
                data-gtm-event="contact_click"
                data-gtm-location="contact_page"
                data-gtm-label="whatsapp"
              >
                <span>WhatsApp</span>
              </a>
            </li>
            <li class="border-t border-(--color-hairline)">
              <a
                href="https://www.instagram.com/logic_and_lines/?hl=en"
                target="_blank"
                rel="noopener noreferrer"
                class="flex min-h-11 items-center py-4 text-base text-(--color-text) transition-colors duration-200 hover:text-(--color-primary)"
                aria-label="Síguenos en Instagram"
                data-gtm-event="social_click"
                data-gtm-location="contact_page"
                data-gtm-label="instagram"
              >
                <span>Instagram</span>
              </a>
            </li>
            <!-- TODO: añadir URL de Facebook cuando esté disponible -->
            <li class="border-t border-(--color-hairline)">
              <span
                class="flex min-h-11 items-center py-4 text-base text-(--color-text) hidden"
                aria-label="Síguenos en Facebook"
              >
                <span>Facebook</span>
              </span>
            </li>
            <li class="border-t border-(--color-hairline)">
              <a
                href="mailto:logicandlinestudios@gmail.com"
                target="_blank"
                rel="noopener noreferrer"
                class="flex min-h-11 items-center py-4 text-base text-(--color-text) transition-colors duration-200 hover:text-(--color-primary)"
                aria-label="Envianos un email"
                data-gtm-event="contact_click"
                data-gtm-location="contact_page"
                data-gtm-label="email"
              >
                <span>Email</span>
              </a>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Circuito: la línea entra desde el borde izquierdo de la retícula y cierra en el CTA de Cal.com -->
    <div class="mx-auto flex w-full max-w-[1400px] items-center gap-0 px-6 lg:px-10">
      <svg class="h-2 min-w-0 flex-1 overflow-visible" aria-hidden="true">
        <line
          x1="0"
          y1="4"
          x2="100%"
          y2="4"
          stroke="var(--color-primary)"
          stroke-width="2"></line>
      </svg>
      <svg
        class="h-2.5 w-2.5 shrink-0"
        viewBox="0 0 10 10"
        aria-hidden="true"
      >
        <circle cx="5" cy="5" r="4.5" fill="var(--color-primary)"></circle>
      </svg>
      <button
        type="button"
        class="ml-5 inline-flex h-12 shrink-0 items-center justify-center whitespace-nowrap bg-(--color-primary) px-6 text-sm font-medium text-(--color-bg) transition-colors duration-200 hover:bg-(--color-primary-hover) active:translate-y-px"
        data-gtm-event="schedule_click"
        data-gtm-location="contact_page"
        data-gtm-label="cal_evaluation_call"
        data-cal-link="logic-and-lines-knzt9s/1ª-llamada-de-evaluacion"
        data-cal-namespace="1ª-llamada-de-evaluacion"
        data-cal-config='{"layout":"month_view","useSlotsViewOnSmallScreen":"true","theme":"dark"}'
      >
        {t.buttons.book}
      </button>
    </div>
    <div class="h-20 lg:h-24"></div>

    <!-- Cal element-click embed code begins -->
    <script type="text/javascript">
    (function (C, A, L) {
      let p = function (a, ar) {
        a.q.push(ar);
      };
      let d = C.document;
      C.Cal =
        C.Cal ||
        function () {
          let cal = C.Cal;
          let ar = arguments;
          if (!cal.loaded) {
            cal.ns = {};
            cal.q = cal.q || [];
            d.head.appendChild(d.createElement("script")).src = A;
            cal.loaded = true;
          }
          if (ar[0] === L) {
            const api = function () {
              p(api, arguments);
            };
            const namespace = ar[1];
            api.q = api.q || [];
            if (typeof namespace === "string") {
              cal.ns[namespace] = cal.ns[namespace] || api;
              p(cal.ns[namespace], ar);
              p(cal, ["initNamespace", namespace]);
            } else p(cal, ar);
            return;
          }
          p(cal, ar);
        };
    })(window, "https://app.cal.com/embed/embed.js", "init");
    Cal("init", "1ª-llamada-de-evaluacion", {
      origin: "https://app.cal.com",
    });

    Cal.ns["1ª-llamada-de-evaluacion"]("ui", {
      theme: "dark",
      cssVarsPerTheme: { light: { "cal-brand": "#0D1A1F" } },
      hideEventTypeDetails: false,
      layout: "month_view",
    });

    Cal.ns["1ª-llamada-de-evaluacion"]("on", {
      action: "bookingSuccessful",
      callback: function () {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: "generated_lead" });
      },
    });
  </script>
  <!-- Cal element-click embed code ends -->

  <!-- Meta Pixel: evento Schedule al pulsar el botón de Cal.com -->
  <script is:inline>
    document.addEventListener('astro:page-load', () => {
      const calButton = document.querySelector('[data-cal-link]');
      if (calButton) {
        calButton.addEventListener('click', () => {
          if (typeof trackMetaEvent === 'function') {
            trackMetaEvent('Schedule', {
              content_name: 'cal_booking',
              content_category: 'scheduling'
            });
          }
        });
      }
    });
  </script>
  </main>
  <SiteFooter currentLang={currentLang} homePrefix="/" />
  <script type="application/ld+json" set:html={JSON.stringify(contactSchema)} />
</Layout>

<script is:inline>
  document.addEventListener('astro:page-load', () => {
    if (typeof trackMetaEvent === 'function') {
      trackMetaEvent('Lead', {
        content_name: 'contact_page',
        content_category: 'lead'
      });
    }

    if (typeof trackMetaEvent !== 'function') return;

    document.querySelectorAll('a[href^="mailto:"]').forEach(link => {
      link.addEventListener('click', () => {
        trackMetaEvent('Contact', {
          content_name: 'email',
          contact_type: 'email'
        });
        // Fallback: copiar email al portapapeles para navegadores sin cliente de email
        const email = link.getAttribute('href').replace('mailto:', '');
        if (navigator.clipboard) {
          navigator.clipboard.writeText(email).catch(() => {});
        }
      });
    });

    document.querySelectorAll('a[href^="https://wa.me/"]').forEach(link => {
      link.addEventListener('click', () => {
        trackMetaEvent('Contact', {
          content_name: 'whatsapp',
          contact_type: 'whatsapp'
        });
      });
    });
  });
</script>
