---
// Confirmación de llamada (F1-SUBPAGES, Dirección C): confirmación sobria en
// gramática C — misma estructura que el v1 (sin header de nav; el v1 tampoco lo
// tenía) con el SiteFooter nuevo. noindex, los metas y los dos scripts de
// tracking se conservan tal cual (mismo evento, mismo orden, mismos atributos).
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import GoogleTagManager from "../components/layout/GoogleTagManager.astro";
import GoogleTagManagerBody from "../components/layout/GoogleTagManagerBody.astro";
import MetaPixel from "../components/MetaPixel.astro";
import SiteFooter from "../components/sections/SiteFooter.astro";

export const prerender = true;

const title = "Llamada Confirmada | Logic & Lines";
const description =
    "Tu llamada de evaluación está confirmada. Te esperamos para analizar cómo automatizar tu negocio.";

const steps = [
    {
        n: "1",
        title: "Revisión previa de tu negocio",
        text: "Antes de la llamada, revisaremos brevemente tu web y procesos públicos para entender tu contexto.",
    },
    {
        n: "2",
        title: "Llamada de evaluación (30 min)",
        text: "Conversamos sobre tu situación actual, identificamos cuellos de botella y oportunidades de mejora.",
    },
    {
        n: "3",
        title: "Identificación de procesos clave",
        text: "Detectamos qué procesos tienen mayor impacto si se automatizan (gestión de leads, seguimiento, reporting, etc.).",
    },
    {
        n: "4",
        title: "Definición del siguiente paso",
        text: "Si tiene sentido trabajar juntos, te proponemos un Sprint de Automatización. Si no, te lo diremos con total transparencia.",
    },
];

const prepItems = [
    {
        title: "Ten claro cómo entran tus leads",
        text: "Formularios, llamadas, redes sociales, referidos... ¿Cómo llegan? ¿Qué pasa después?",
    },
    {
        title: "Identifica procesos manuales",
        text: "¿Qué tareas repetitivas hace tu equipo cada día? Copiar datos, enviar emails, actualizar hojas...",
    },
    {
        title: "Piensa dónde se pierde tiempo o dinero",
        text: "Leads sin seguimiento, tareas que tardan horas, errores recurrentes... ¿Qué duele más?",
    },
    {
        title: "Define tu objetivo principal",
        text: "¿Quieres convertir más leads? ¿Reducir errores? ¿Tener visibilidad del proceso? Prioriza uno.",
    },
];

const idealItems = [
    "Tienes leads activos y proceso comercial en marcha",
    "Tu equipo hace tareas manuales repetitivas",
    'Buscas resultados medibles, no solo "software"',
    "Estás dispuesto a invertir en mejora operativa",
];

const notIdealItems = [
    "Estás empezando desde cero (aún no tienes procesos)",
    "Buscas software barato o plantillas genéricas",
    'Quieres soluciones "mágicas" sin esfuerzo',
    "No estás listo para implementar cambios",
];

const notThisItems = [
    {
        title: "Una demo de software",
        text: "No vamos a enseñarte n8n, Make o cualquier herramienta. Hablamos de tu negocio, no de tecnología.",
    },
    {
        title: "Una llamada de ventas agresiva",
        text: "Si no tiene sentido trabajar juntos, te lo diremos directamente. No presionamos a nadie.",
    },
    {
        title: "Consultoría gratuita ilimitada",
        text: "Es una evaluación inicial. Si queremos profundizar, será dentro de un Sprint pagado.",
    },
];

const howItems = [
    {
        title: "Sistemas, no herramientas",
        text: "No vendemos software. Diseñamos sistemas adaptados a cada negocio.",
    },
    {
        title: "Resultados rápidos",
        text: "Sprint de 7-14 días con una automatización real implementada.",
    },
    {
        title: "Transparencia total",
        text: "Sabes qué vamos a hacer, cuánto tarda y qué vas a recibir.",
    },
];

const reflectionItems = [
    {
        title: "¿Cuántos leads pierdes al mes?",
        text: "Por no hacer seguimiento o responder tarde.",
    },
    {
        title: "¿Cuántas horas semanales se pierden?",
        text: "En tareas manuales que podrían automatizarse.",
    },
    {
        title: "¿Qué pasaría si automatizan eso?",
        text: "Más conversiones, más tiempo, menos errores.",
    },
];
---

<!doctype html>
<html lang="es" class="overflow-x-hidden">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/logoSolo.svg" />

        <title>{title}</title>
        <meta name="title" content={title} />
        <meta name="description" content={description} />
        <meta name="robots" content="noindex, nofollow" />

        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />

        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:title" content={title} />
        <meta property="twitter:description" content={description} />

        <ClientRouter />
        <!-- Self-hosted faces (v4): preload the two most critical ones -->
        <link rel="preload" href="/fonts/sentient-400.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="preload" href="/fonts/cabinet-grotesk-400.woff2" as="font" type="font/woff2" crossorigin />
        <GoogleTagManager />
        <MetaPixel />
    </head>

    <body
        class="bg-(--color-bg) text-(--color-text) min-h-screen overflow-x-hidden"
    >
        <GoogleTagManagerBody />
        <main>
            {/* Confirmación: tramo de línea + nodo, titular y dato en mono */}
            <section
                class="mx-auto w-full max-w-[1400px] px-6 pb-16 pt-16 lg:px-10 lg:pb-24 lg:pt-24"
            >
                <img
                    src="/logoEntero.svg"
                    alt="Logic & Lines"
                    width="223"
                    height="48"
                    loading="lazy"
                    decoding="async"
                    class="h-12 w-auto md:h-16"
                />

                <svg
                    class="mt-12 h-3 w-full max-w-[22rem] overflow-visible"
                    viewBox="0 0 352 12"
                    preserveAspectRatio="xMinYMid meet"
                    aria-hidden="true"
                >
                    <line
                        x1="0"
                        y1="6"
                        x2="334"
                        y2="6"
                        stroke="var(--color-primary)"
                        stroke-width="2"></line>
                    <circle
                        cx="342"
                        cy="6"
                        r="5"
                        fill="var(--color-primary)"></circle>
                </svg>

                <h1
                    class="mt-12 max-w-[18ch] font-display text-[clamp(2.25rem,5vw,4.5rem)] font-normal leading-[1.12] tracking-[-0.04em] text-(--color-text)"
                >
                    ¡Tu llamada está confirmada!
                </h1>

                <p class="mt-8 max-w-[65ch] text-lg leading-relaxed text-(--color-text-dark)">
                    En breve recibirás un email con todos los detalles de la
                    llamada. Revisa tu bandeja de entrada (y spam, por si
                    acaso).
                </p>

                <p
                    class="mt-10 border-t border-(--color-hairline) pt-5 font-mono text-xs tabular-nums text-(--color-text-dark)"
                >
                    La llamada ya está en tu calendario
                </p>
            </section>

            {/* Qué va a pasar ahora: raíl vertical con nodos */}
            <section
                class="mx-auto w-full max-w-[1400px] border-t border-(--color-hairline) px-6 pb-16 pt-16 lg:px-10 lg:pb-24 lg:pt-24"
            >
                <h2
                    class="max-w-[18ch] font-display text-[clamp(2rem,4.5vw,3.5rem)] leading-[1.12] tracking-[-0.04em] text-(--color-text)"
                >
                    ¿Qué va a pasar ahora?
                </h2>

                <ol class="mt-12">
                    {
                        steps.map((s, i) => {
                            const isLast = i === steps.length - 1;
                            return (
                                <li class="relative pb-10 last:pb-0">
                                    <svg
                                        class="pointer-events-none absolute left-0 top-0 h-full w-2 overflow-visible"
                                        aria-hidden="true"
                                    >
                                        <line
                                            x1="3"
                                            y1="0"
                                            x2="3"
                                            y2={isLast ? "8" : "100%"}
                                            stroke="var(--color-primary)"
                                            stroke-width="2"
                                        />
                                        <circle
                                            cx="3"
                                            cy="8"
                                            r="5"
                                            fill="var(--color-primary)"
                                        />
                                    </svg>
                                    <div class="pl-10 md:pl-16">
                                        <p class="font-mono text-sm tabular-nums text-(--color-text-dark)">
                                            {s.n}
                                        </p>
                                        <h3 class="mt-3 font-display text-2xl leading-[1.12] tracking-[-0.02em] text-(--color-text) md:text-3xl">
                                            {s.title}
                                        </h3>
                                        <p class="mt-3 max-w-[65ch] text-base leading-relaxed text-(--color-text-dark)">
                                            {s.text}
                                        </p>
                                    </div>
                                </li>
                            );
                        })
                    }
                </ol>
            </section>

            {/* Cómo prepararte: filas editoriales desfasadas en dos columnas */}
            <section
                class="mx-auto w-full max-w-[1400px] border-t border-(--color-hairline) px-6 pb-16 pt-16 lg:px-10 lg:pb-24 lg:pt-24"
            >
                <h2
                    class="max-w-[18ch] font-display text-[clamp(2rem,4.5vw,3.5rem)] leading-[1.12] tracking-[-0.04em] text-(--color-text)"
                >
                    Cómo prepararte para la llamada
                </h2>
                <p class="mt-6 max-w-[65ch] text-lg leading-relaxed text-(--color-text-dark)">
                    No es un examen. Solo queremos aprovechar mejor el tiempo.
                </p>

                <ul class="mt-12 grid grid-cols-1 gap-x-12 gap-y-8 md:grid-cols-12">
                    {
                        prepItems.map((item, i) => (
                            <li
                                class={`border-t border-(--color-hairline) pt-5 ${
                                    i % 2 === 0
                                        ? "md:col-span-7"
                                        : "md:col-span-5 md:mt-8"
                                }`}
                            >
                                <h3 class="font-display text-xl leading-snug text-(--color-text) md:text-2xl">
                                    {item.title}
                                </h3>
                                <p class="mt-3 max-w-[65ch] text-base leading-relaxed text-(--color-text-dark)">
                                    {item.text}
                                </p>
                            </li>
                        ))
                    }
                </ul>
            </section>

            {/* Para quién sí / no: dos columnas con filas de un solo borde */}
            <section
                class="mx-auto w-full max-w-[1400px] border-t border-(--color-hairline) px-6 pb-16 pt-16 lg:px-10 lg:pb-24 lg:pt-24"
            >
                <h2
                    class="max-w-[22ch] font-display text-[clamp(2rem,4.5vw,3.5rem)] leading-[1.12] tracking-[-0.04em] text-(--color-text)"
                >
                    Recordatorio: ¿Para quién es esta llamada?
                </h2>

                <div class="mt-12 grid grid-cols-1 gap-x-12 gap-y-12 md:grid-cols-2">
                    <div>
                        <h3 class="font-display text-xl leading-snug text-(--color-text) md:text-2xl">
                            Es ideal si...
                        </h3>
                        <ul class="mt-6">
                            {
                                idealItems.map((item) => (
                                    <li class="border-t border-(--color-hairline) py-4 text-base leading-relaxed text-(--color-text)">
                                        {item}
                                    </li>
                                ))
                            }
                        </ul>
                    </div>
                    <div>
                        <h3 class="font-display text-xl leading-snug text-(--color-text) md:text-2xl">
                            No es ideal si...
                        </h3>
                        <ul class="mt-6">
                            {
                                notIdealItems.map((item) => (
                                    <li class="border-t border-(--color-hairline) py-4 text-base leading-relaxed text-(--color-text-dark)">
                                        {item}
                                    </li>
                                ))
                            }
                        </ul>
                    </div>
                </div>
            </section>

            {/* Qué NO es esta llamada: filas apiladas */}
            <section
                class="mx-auto w-full max-w-[1400px] border-t border-(--color-hairline) px-6 pb-16 pt-16 lg:px-10 lg:pb-24 lg:pt-24"
            >
                <h2
                    class="max-w-[18ch] font-display text-[clamp(2rem,4.5vw,3.5rem)] leading-[1.12] tracking-[-0.04em] text-(--color-text)"
                >
                    Para que estemos alineados...
                </h2>

                <h3
                    class="mt-12 max-w-[65ch] border-t border-(--color-hairline) pt-8 font-display text-2xl leading-snug text-(--color-text)"
                >
                    Esta llamada NO es:
                </h3>

                <ul class="mt-2">
                    {
                        notThisItems.map((item) => (
                            <li class="border-t border-(--color-hairline) py-6">
                                <h4 class="font-display text-xl leading-snug text-(--color-text)">
                                    {item.title}
                                </h4>
                                <p class="mt-2 max-w-[65ch] text-base leading-relaxed text-(--color-text-dark)">
                                    {item.text}
                                </p>
                            </li>
                        ))
                    }
                </ul>
            </section>

            {/* Cómo trabajamos: tres columnas con hairline superior */}
            <section
                class="mx-auto w-full max-w-[1400px] border-t border-(--color-hairline) px-6 pb-16 pt-16 lg:px-10 lg:pb-24 lg:pt-24"
            >
                <h2
                    class="max-w-[18ch] font-display text-[clamp(2rem,4.5vw,3.5rem)] leading-[1.12] tracking-[-0.04em] text-(--color-text)"
                >
                    Cómo trabajamos
                </h2>

                <ul class="mt-12 grid grid-cols-1 gap-x-10 gap-y-8 sm:grid-cols-3">
                    {
                        howItems.map((item) => (
                            <li class="border-t border-(--color-hairline) pt-5">
                                <h3 class="font-display text-xl leading-snug text-(--color-text)">
                                    {item.title}
                                </h3>
                                <p class="mt-3 text-base leading-relaxed text-(--color-text-dark)">
                                    {item.text}
                                </p>
                            </li>
                        ))
                    }
                </ul>
            </section>

            {/* Mientras tanto: preguntas en filas desfasadas */}
            <section
                class="mx-auto w-full max-w-[1400px] border-t border-(--color-hairline) px-6 pb-20 pt-16 lg:px-10 lg:pb-28 lg:pt-24"
            >
                <h2
                    class="max-w-[18ch] font-display text-[clamp(2rem,4.5vw,3.5rem)] leading-[1.12] tracking-[-0.04em] text-(--color-text)"
                >
                    Mientras tanto...
                </h2>
                <p class="mt-6 max-w-[65ch] text-lg leading-relaxed text-(--color-text-dark)">
                    Si quieres llegar más preparado a la llamada, aquí tienes
                    algunas preguntas para reflexionar:
                </p>

                <ul class="mt-12 grid grid-cols-1 gap-x-12 gap-y-8 md:grid-cols-12">
                    {
                        reflectionItems.map((item, i) => (
                            <li
                                class={`border-t border-(--color-hairline) pt-5 ${
                                    i % 2 === 0
                                        ? "md:col-span-7"
                                        : "md:col-span-5 md:mt-8"
                                }`}
                            >
                                <h3 class="font-display text-xl leading-snug text-(--color-text) md:text-2xl">
                                    {item.title}
                                </h3>
                                <p class="mt-3 max-w-[65ch] text-base leading-relaxed text-(--color-text-dark)">
                                    {item.text}
                                </p>
                            </li>
                        ))
                    }
                </ul>
            </section>
        </main>

        <SiteFooter currentLang="es" homePrefix="/" />

        <script is:inline>
            document.addEventListener('astro:page-load', () => {
                if (typeof trackMetaEvent === 'function') {
                    trackMetaEvent('Schedule', {
                        content_name: 'evaluation_call_confirmed',
                        content_category: 'scheduling'
                    });
                }
            });
        </script>
        <script is:inline>
            window.dataLayer = window.dataLayer || [];
            window.dataLayer.push({ event: 'generated_lead' });
        </script>
        <!-- Listener delegado de data-gtm-event (copia literal del Layout) para
             que los atributos GTM del SiteFooter funcionen en esta página -->
        <script is:inline>
            document.addEventListener('click', function (e) {
                var el = e.target.closest('[data-gtm-event]');
                if (!el) return;
                window.dataLayer = window.dataLayer || [];
                window.dataLayer.push({
                    event: el.dataset.gtmEvent,
                    gtm_location: el.dataset.gtmLocation || '',
                    gtm_label: el.dataset.gtmLabel || '',
                    url: el.href || '',
                });
            });
        </script>
    </body>
</html>
