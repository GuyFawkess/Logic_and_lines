---
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/sections/SiteHeader.astro";
import HeroHome from "../../components/sections/HeroHome.astro";
import MarqueeBand from "../../components/sections/MarqueeBand.astro";
import Thesis from "../../components/sections/Thesis.astro";
import ServicesIndex from "../../components/sections/ServicesIndex.astro";
import ProcessRail from "../../components/sections/ProcessRail.astro";
import Proof from "../../components/sections/Proof.astro";
import FaqIndex from "../../components/sections/FaqIndex.astro";
import BookingClose from "../../components/sections/BookingClose.astro";
import SiteFooter from "../../components/sections/SiteFooter.astro";

export const prerender = true;

const currentLang = "en";

// WebSite + Organization schemas for the home page
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "url": "https://logicandlines.com/en/",
  "name": "Logic & Lines",
  "description": "Marketing & AI Automation Agency. We transform businesses through advanced digital strategies and intelligent automation.",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://logicandlines.com/en/?s={search_term_string}",
    "query-input": "required name=search_term_string"
  }
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Logic & Lines",
  "url": "https://logicandlines.com/en/",
  "logo": "https://logicandlines.com/logoEntero.svg",
  "sameAs": [
    "https://www.instagram.com/logic_and_lines/?hl=en"
  ]
};
---

<Layout
	title="AI Automation Agency"
	description="Logic & Lines: Marketing & AI Automation Agency. We transform businesses through advanced digital strategies and intelligent automation."
	ogImage="/logoNoSub.svg"
	chrome={false}
>
	<!-- Home page exclusive JSON-LD schemas -->
	<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
	<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

	<!-- The page's single H1 is the hero claim (HeroHome) -->
	<SiteHeader currentLang={currentLang} />
	<main>
		<HeroHome currentLang={currentLang} />
		<MarqueeBand currentLang={currentLang} />
		<Thesis currentLang={currentLang} />
		<!-- Line-native shutter (F3-v2, SINGLE USE): styleless wrapper; everything
		     ephemeral is created by shutter.ts only with JS and lg viewport.
		     Without JS or on mobile: normal flow, zero overlays. -->
		<div data-shutter>
			<ServicesIndex currentLang={currentLang} />
		</div>
		<!-- Horizontal chapter shutter (F4-t2): dark-to-light flip when entering
		     the light chapter. Styleless wrapper; everything ephemeral is created
		     by shutter.ts only with JS and lg viewport. Without JS or on mobile:
		     normal flow, zero overlays. -->
		<div data-shutter-h>
			<ProcessRail currentLang={currentLang} />
		</div>
		<Proof currentLang={currentLang} />
		<div data-shutter-h>
			<FaqIndex currentLang={currentLang} />
		</div>
		<BookingClose currentLang={currentLang} />
	</main>
	<SiteFooter currentLang={currentLang} />
</Layout>
