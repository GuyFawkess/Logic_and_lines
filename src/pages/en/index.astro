---
import Hero from "../../components/Hero.astro";
import Stats from "../../components/Stats.astro";
import BenefitsList from "../../components/BenefitsList.astro";
import Layout from "../../layouts/Layout.astro";
import ServicesList from "../../components/ServicesList.astro";
import ReasonsList from "../../components/ReasonsList.astro";
import BookButton from "../../components/BookButton.astro";
import Proceso from "../../components/Proceso.astro";
import Booking from "../../components/Booking.astro";
import FAQ from "../../components/FAQ.astro";

export const prerender = true;

const currentLang = "en";

// WebSite + Organization schemas for the home page
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "url": "https://logicandlines.com/en/",
  "name": "Logic & Lines",
  "description": "Marketing & AI Automation Agency. We transform businesses through advanced digital strategies and intelligent automation.",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://logicandlines.com/en/?s={search_term_string}",
    "query-input": "required name=search_term_string"
  }
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Logic & Lines",
  "url": "https://logicandlines.com/en/",
  "logo": "https://logicandlines.com/logoEntero.svg",
  "sameAs": [
    "https://www.instagram.com/logic_and_lines/?hl=en"
  ]
};
---

<Layout
	title="AI Automation Agency"
	description="Logic & Lines: Marketing & AI Automation Agency. We transform businesses through advanced digital strategies and intelligent automation."
	ogImage="/logoNoSub.svg"
>
	<!-- sr-only H1 for screen readers and SEO (hero uses h2 by design) -->
	<h1 class="sr-only">Logic & Lines — Intelligent Automation for Businesses</h1>

	<!-- Home page exclusive JSON-LD schemas -->
	<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
	<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

	<Hero currentLang={currentLang} />
	<Stats currentLang={currentLang} />
	<BenefitsList currentLang={currentLang} />
	<ServicesList currentLang={currentLang} />
	<Proceso currentLang={currentLang} />
	<!-- <Opinion currentLang={currentLang} /> -->
	<ReasonsList currentLang={currentLang} />
	<Booking currentLang={currentLang} />
	<FAQ currentLang={currentLang} />
</Layout>
