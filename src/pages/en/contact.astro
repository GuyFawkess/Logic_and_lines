---
import Layout from "../../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { useTranslations } from "../../i18n/utils";

export const prerender = true;

const currentLang = "en";
const t = useTranslations(currentLang);

const pageTitle = t.seo.contactTitle;
const pageDescription = t.seo.contactDescription;
const fullTitle = `${pageTitle} | Logic & Lines`;
const canonicalURL = "https://logicandlines.com/en/contact";

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: fullTitle,
  url: canonicalURL,
  description: pageDescription,
  mainEntity: {
    "@type": "Organization",
    name: "Logic & Lines",
    email: "logicandlinestudios@gmail.com",
    url: "https://logicandlines.com",
    sameAs: ["https://www.instagram.com/logic_and_lines/?hl=en"],
  },
};
---

<Layout title={pageTitle} description={pageDescription}>
  <main class="w-full mb-20 py-10 px-4 text-center">
    <div class="max-w-6xl mx-auto">
      <h1 class="text-3xl font-bold mb-8 text-(--color-terracotta)">
        {t.contact.title}
      </h1>
      <div class="flex flex-col md:flex-row gap-10">
        <div class="md:block w-full md:w-1/2 h-full mx-auto text-left">
          <h2
            class="text-xl font-medium mb-4 text-(--color-atention) text-center"
          >
            {t.contact.info}
          </h2>
          <h3 class="mb-3 font-medium">
            {t.contact.thankYou}
          </h3>
          <p class="mb-3">
            {t.contact.preparation}
          </p>
          <p class="mb-3">
            {t.contact.offering}
          </p>
          <p class="mb-3">
            {t.contact.bookSession}
          </p>
          <p>{t.contact.lookForward}</p>
        </div>
        <div class="w-full md:w-1/2 text-left h-full">
          <h2
            class="text-xl font-medium mb-4 text-(--color-atention) text-center"
          >
            {t.contact.reachMe}
          </h2>
          <ul class="flex flex-col space-y-8 w-full ml-6 md:ml-16 lg:ml-20">
            <li class="flex items-center">
              <a
                href="https://wa.me/34628125302"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Contact us on WhatsApp"
                class="flex items-center gap-3 group"
                data-gtm-event="contact_click"
                data-gtm-location="contact_page_en"
                data-gtm-label="whatsapp"
              >
                <span class="inline-block">
                  <Icon
                    name="whatsapp"
                    class="text-3xl text-(--color-deep-charcoal) transition duration-200 ease-in-out group-hover:scale-125 group-hover:text-(--color-terracotta)"
                  />
                </span>
                <span>WhatsApp</span>
              </a>
            </li>
            <li class="flex items-center">
              <a
                href="https://www.instagram.com/logic_and_lines/?hl=en"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-3 group"
                aria-label="Follow us on Instagram"
                data-gtm-event="social_click"
                data-gtm-location="contact_page_en"
                data-gtm-label="instagram"
              >
                <span class="inline-block">
                  <Icon
                    name="instagram"
                    class="text-3xl text-(--color-deep-charcoal) transition duration-200 ease-in-out group-hover:scale-125 group-hover:text-(--color-terracotta)"
                  />
                </span>
                <span>Instagram</span>
              </a>
            </li>
            <!-- TODO: añadir URL de Facebook cuando esté disponible -->
            <li class="flex items-center">
              <span
                class="flex items-center gap-3 group hidden"
                aria-label="Follow us on Facebook"
              >
                <span class="inline-block">
                  <Icon
                    name="facebook3"
                    class="text-3xl text-(--color-deep-charcoal) transition duration-200 ease-in-out group-hover:scale-125 group-hover:text-(--color-terracotta)"
                  />
                </span>
                <span>Facebook</span>
              </span>
            </li>
            <li class="flex items-center">
              <a
                href="mailto:logicandlinestudios@gmail.com"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-3 group"
                aria-label="Send us an email"
                data-gtm-event="contact_click"
                data-gtm-location="contact_page_en"
                data-gtm-label="email"
              >
                <span class="inline-block">
                  <Icon
                    name="gmail2"
                    class="text-3xl text-(--color-deep-charcoal) transition duration-200 ease-in-out group-hover:scale-125 group-hover:text-(--color-terracotta)"
                  />
                </span>
                <span>Email</span>
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </main>
  <script type="application/ld+json" set:html={JSON.stringify(contactSchema)} />
</Layout>

<script is:inline>
  document.addEventListener('astro:page-load', () => {
    if (typeof trackMetaEvent === 'function') {
      trackMetaEvent('Lead', {
        content_name: 'contact_page',
        content_category: 'lead'
      });
    }

    if (typeof trackMetaEvent !== 'function') return;

    document.querySelectorAll('a[href^="mailto:"]').forEach(link => {
      link.addEventListener('click', () => {
        trackMetaEvent('Contact', {
          content_name: 'email',
          contact_type: 'email'
        });
        // Fallback: copiar email al portapapeles para navegadores sin cliente de email
        const email = link.getAttribute('href').replace('mailto:', '');
        if (navigator.clipboard) {
          navigator.clipboard.writeText(email).catch(() => {});
        }
      });
    });

    document.querySelectorAll('a[href^="https://wa.me/"]').forEach(link => {
      link.addEventListener('click', () => {
        trackMetaEvent('Contact', {
          content_name: 'whatsapp',
          contact_type: 'whatsapp'
        });
      });
    });
  });
</script>
