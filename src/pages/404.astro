---
// 404 (F1-SUBPAGES, Dirección C): póster tipográfico — cifra gigante en
// Sentient, tramo estático de la Línea Maestra y copio breve del v1. Sin
// eventos GTM (el v1 tampoco los tenía en este enlace).
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/sections/SiteHeader.astro";
import SiteFooter from "../components/sections/SiteFooter.astro";

export const prerender = true;
---

<Layout
  title="Página No Encontrada"
  description="Lo sentimos, la página que estás buscando no existe. Vuelve a la página principal de Logic and Lines."
  chrome={false}
>
  <SiteHeader currentLang="es" homePrefix="/" />
  <main>
    <section
      class="mx-auto flex min-h-[72dvh] w-full max-w-[1400px] flex-col justify-center px-6 pb-20 pt-16 lg:px-10 lg:pb-28 lg:pt-24"
    >
      <h1
        class="font-display font-normal leading-[0.9] tracking-[-0.04em] text-(--color-text)"
        data-reveal="lines"
      >
        <span class="block text-[clamp(5rem,20vw,13rem)]">404</span>
        <span
          class="mt-6 block text-[clamp(1.75rem,3.2vw,2.75rem)] leading-[1.12] tracking-[-0.02em]"
          >Página No Encontrada</span
        >
      </h1>

      <!-- Tramo de línea estático con nodo -->
      <svg
        class="mt-10 h-3 w-full max-w-[22rem] overflow-visible"
        viewBox="0 0 352 12"
        preserveAspectRatio="xMinYMid meet"
        aria-hidden="true"
      >
        <line
          x1="0"
          y1="6"
          x2="334"
          y2="6"
          stroke="var(--color-primary)"
          stroke-width="2"></line>
        <circle cx="342" cy="6" r="5" fill="var(--color-primary)"></circle>
      </svg>

      <p class="mt-10 max-w-[65ch] text-lg leading-relaxed text-(--color-text-dark)">
        Lo sentimos, la página que estás buscando no existe.
      </p>

      <div>
        <a
          href="/"
          class="mt-10 inline-flex h-12 items-center justify-center whitespace-nowrap bg-(--color-primary) px-6 text-sm font-medium text-(--color-bg) transition-colors duration-200 hover:bg-(--color-primary-hover) active:translate-y-px"
          >Volver a la Página Principal</a
        >
      </div>
    </section>
  </main>
  <SiteFooter currentLang="es" homePrefix="/" />
</Layout>
