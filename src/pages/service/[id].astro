---
// Ficha de servicio v4 (F1-SUBPAGES, Dirección C). Conserva getStaticPaths,
// la selección de campos del v1, el modo legacy (body markdown estilizado), el
// JSON-LD Service y el script de ViewContent tal cual. Composiciones: hero
// editorial asimétrico, problema en split, solución como statement con tramo de
// línea, automatización en filas numeradas agrupadas, beneficios en filas
// editoriales desfasadas, casos de uso colgando de un raíl con nodos y cierre en
// circuito con CTA. Sin cards iguales, sin iconos decorativos.
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/sections/SiteHeader.astro";
import SiteFooter from "../../components/sections/SiteFooter.astro";
import BookButton from "../../components/BookButton.astro";

export const prerender = true;

export async function getStaticPaths() {
  const services = await getCollection("services");
  return services.map((service) => ({
    params: { id: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const { Content } = await render(service);
const { data, slug } = service;

// Fallback for services not yet updated to new schema
// (hero.aeo_paragraph sigue sin renderizar, como en el v1: se habilita desde
// el markdown de la colección si algún día se quiere mostrar)
const title = data.title;
const img = data.img;

const hero = data.hero || {
  subtitle: data.specification || "",
  phrase: data.description || "",
  aeo_paragraph: "",
  cta: "Agendar llamada",
};

const problem = data.problem;
const solution = data.solution;
const automation = data.automation;
const benefits = data.benefits;
const use_cases = data.use_cases;
const final_cta = data.final_cta;

const isLegacy = !problem; // If no problem section, render legacy content mode
const hasBody = (service.body ?? "").trim().length > 0;

// Dimensiones intrínsecas reales de las webp (cabecera RIFF/VP8X/VP8)
const imageDims: Record<string, { w: number; h: number }> = {
  "/logic-map/logic-map-2.webp": { w: 1184, h: 864 },
  "/sales-line/funnels-provisional.webp": { w: 1024, h: 768 },
  "/flow-line/flow-line-2.webp": { w: 1024, h: 768 },
  "/logic-agent/logic-agents-2.webp": { w: 1032, h: 755 },
  "/logic-support/logic-support-3.webp": { w: 1024, h: 1024 },
  "/smarthost/smarthost-2.webp": { w: 1024, h: 1024 },
};
const dims = imageDims[img] ?? { w: 1024, h: 768 };

// La descripción de solution trae párrafos separados por líneas en blanco
const solutionParagraphs = (solution?.description ?? "")
  .split(/\n\n+/)
  .map((p) => p.trim())
  .filter(Boolean);

const num = (i: number) => String(i + 1).padStart(2, "0");

// Automatización: filas numeradas agrupadas en dos columnas
// (nunca >5 bullets uniformes sin agrupar)
const automationItems = automation?.items ?? [];
const automationHalf = Math.ceil(automationItems.length / 2);
const automationGroups = [
  automationItems.slice(0, automationHalf).map((item, i) => ({ n: num(i), item })),
  automationItems
    .slice(automationHalf)
    .map((item, i) => ({ n: num(automationHalf + i), item })),
];

// Generate Service schema
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: title,
  description: hero.phrase,
  provider: {
    "@type": "ProfessionalService",
    name: "Logic & Lines",
  },
  areaServed: "Worldwide",
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Core Services",
    itemListElement: [
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: title,
        },
      },
    ],
  },
};
---

<Layout title={title} description={hero.phrase} chrome={false}>
  <SiteHeader currentLang="es" homePrefix="/" />
  <main>
    {/* HERO editorial: texto ancho a la izquierda, imagen real descolgada */}
    <section
      class="mx-auto w-full max-w-[1400px] px-6 pb-16 pt-20 lg:px-10 lg:pb-24 lg:pt-28"
    >
      <div class="grid grid-cols-1 gap-x-10 gap-y-12 md:grid-cols-12">
        <div class="md:col-span-7">
          <h1
            class="max-w-[16ch] font-display text-[clamp(2.5rem,6vw,5rem)] font-normal leading-[1.12] tracking-[-0.04em] text-(--color-text)"
            data-reveal="lines"
          >
            {title}
          </h1>
          <p
            class="mt-6 font-mono text-xs leading-relaxed text-(--color-text-dark) md:text-sm"
          >
            {hero.subtitle}
          </p>
          <p class="mt-8 max-w-[65ch] text-lg leading-relaxed text-(--color-text-dark)">
            {hero.phrase}
          </p>
          <div>
            <a
              href="/#booking"
              class="mt-10 inline-flex h-12 items-center justify-center whitespace-nowrap bg-(--color-primary) px-6 text-sm font-medium text-(--color-bg) transition-colors duration-200 hover:bg-(--color-primary-hover) active:translate-y-px"
            >
              {hero.cta}
            </a>
          </div>
        </div>
        <figure class="md:col-span-4 md:col-start-9 md:mt-20">
          <img
            transition:name={`img-${slug}`}
            src={img}
            width={dims.w}
            height={dims.h}
            loading="lazy"
            decoding="async"
            alt={title}
            class="h-auto w-full"
          />
        </figure>
      </div>
    </section>

    {
      isLegacy ? (
        hasBody ? (
          /* Modo legacy: prosa de contenido markdown con hairlines en headings */
          <section class="mx-auto w-full max-w-[1400px] border-t border-(--color-hairline) px-6 pb-20 pt-16 lg:px-10 lg:pb-28 lg:pt-24">
            <div class="legacy-prose max-w-[65ch]">
              <Content />
            </div>
          </section>
        ) : null
      ) : (
        <>
          {/* PROBLEMA: statement display a la izquierda, puntos en filas */}
          {problem && (
            <section class="mx-auto w-full max-w-[1400px] border-t border-(--color-hairline) px-6 pb-20 pt-20 lg:px-10 lg:pb-28 lg:pt-28">
              <div class="grid grid-cols-1 gap-x-10 gap-y-12 md:grid-cols-12">
                <div class="md:col-span-7">
                  <h2
                    class="max-w-[22ch] font-display text-[clamp(1.875rem,3.6vw,3rem)] leading-[1.15] tracking-[-0.02em] text-(--color-text)"
                    data-reveal="lines"
                    set:html={problem.statement}
                  />
                </div>
                <ul class="md:col-span-4 md:col-start-9">
                  {problem.points?.map((point) => (
                    <li class="border-t border-(--color-hairline) py-4 text-base leading-relaxed text-(--color-text-dark)">
                      {point}
                    </li>
                  ))}
                </ul>
              </div>
            </section>
          )}

          {/* SOLUCIÓN: statement con tramo de línea + nodo (gramática Thesis) */}
          {solution && (
            <section class="mx-auto w-full max-w-[1400px] border-t border-(--color-hairline) px-6 pb-20 pt-20 lg:px-10 lg:pb-28 lg:pt-28">
              <svg
                class="h-3 w-full max-w-[22rem] overflow-visible"
                viewBox="0 0 352 12"
                preserveAspectRatio="xMinYMid meet"
                aria-hidden="true"
              >
                <line
                  x1="0"
                  y1="6"
                  x2="334"
                  y2="6"
                  stroke="var(--color-primary)"
                  stroke-width="2"
                />
                <circle cx="342" cy="6" r="5" fill="var(--color-primary)" />
              </svg>
              <h2
                class="mt-12 max-w-[18ch] font-display text-[clamp(2rem,4.5vw,3.5rem)] leading-[1.12] tracking-[-0.04em] text-(--color-text)"
                data-reveal="lines"
                set:html={solution.title}
              />
              <div class="mt-8 md:pl-[6%]">
                {solutionParagraphs.map((paragraph) => (
                  <p class="mt-6 max-w-[65ch] text-lg leading-relaxed text-(--color-text-dark)">
                    {paragraph}
                  </p>
                ))}
              </div>
            </section>
          )}

          {/* AUTOMATIZACIÓN: filas numeradas, agrupadas en dos columnas */}
          {automation && (
            <section class="mx-auto w-full max-w-[1400px] border-t border-(--color-hairline) px-6 pb-20 pt-20 lg:px-10 lg:pb-28 lg:pt-28">
              <h2
                class="max-w-[18ch] font-display text-[clamp(1.875rem,3.6vw,3rem)] leading-[1.12] tracking-[-0.02em] text-(--color-text)"
                data-reveal="lines"
                set:html={automation.title}
              />
              <div class="mt-12 grid grid-cols-1 gap-x-12 md:grid-cols-2">
                {automationGroups.map((group) => (
                  <ol>
                    {group.map(({ n, item }) => (
                      <li class="border-t border-(--color-hairline) py-4">
                        <p class="font-mono text-xs tabular-nums text-(--color-text-dark)">
                          {n}
                        </p>
                        <p class="mt-2 text-base leading-relaxed text-(--color-text)">
                          {item}
                        </p>
                      </li>
                    ))}
                  </ol>
                ))}
              </div>
            </section>
          )}

          {/* BENEFICIOS: filas editoriales desfasadas (sin números) */}
          {benefits && (
            <section class="mx-auto w-full max-w-[1400px] border-t border-(--color-hairline) px-6 pb-20 pt-20 lg:px-10 lg:pb-28 lg:pt-28">
              <h2
                class="max-w-[18ch] font-display text-[clamp(1.875rem,3.6vw,3rem)] leading-[1.12] tracking-[-0.02em] text-(--color-text)"
                data-reveal="lines"
                set:html={benefits.title}
              />
              <ul class="mt-12 grid grid-cols-1 gap-x-12 gap-y-8 md:grid-cols-12">
                {benefits.items?.map((item, i) => (
                  <li
                    class={`border-t border-(--color-hairline) pt-5 ${
                      i % 2 === 0 ? "md:col-span-7" : "md:col-span-5 md:mt-8"
                    }`}
                  >
                    <p class="font-display text-xl leading-snug text-(--color-text) md:text-2xl">
                      {item}
                    </p>
                  </li>
                ))}
              </ul>
            </section>
          )}

          {/* CASOS DE USO: colgando de un raíl estático con nodos */}
          {use_cases && (
            <section class="mx-auto w-full max-w-[1400px] border-t border-(--color-hairline) px-6 pb-20 pt-20 lg:px-10 lg:pb-28 lg:pt-28">
              <h2
                class="max-w-[18ch] font-display text-[clamp(1.875rem,3.6vw,3rem)] leading-[1.12] tracking-[-0.02em] text-(--color-text)"
                data-reveal="lines"
                set:html={use_cases.title}
              />
              <ol class="mt-12">
                {(use_cases.items ?? []).map((item, i, arr) => (
                  <li class="relative pb-10 last:pb-0">
                    <svg
                      class="pointer-events-none absolute left-0 top-0 h-full w-2 overflow-visible"
                      aria-hidden="true"
                    >
                      <line
                        x1="3"
                        y1="0"
                        x2="3"
                        y2={i === arr.length - 1 ? "8" : "100%"}
                        stroke="var(--color-primary)"
                        stroke-width="2"
                      />
                      <circle cx="3" cy="8" r="5" fill="var(--color-primary)" />
                    </svg>
                    <p class="max-w-[65ch] pl-10 text-base leading-relaxed text-(--color-text) md:pl-16 md:text-lg">
                      {item}
                    </p>
                  </li>
                ))}
              </ol>
            </section>
          )}

          {/* CIERRE: la línea cruza y cierra circuito en el CTA */}
          {final_cta && (
            <section class="w-full border-t border-(--color-hairline) bg-(--color-bg-alt) py-20 lg:py-28">
              <div class="mx-auto w-full max-w-[1400px] px-6 lg:px-10">
                <h2
                  class="max-w-[18ch] font-display text-[clamp(2.25rem,5vw,4.5rem)] leading-[1.12] tracking-[-0.04em] text-(--color-text)"
                  data-reveal="lines"
                  set:html={final_cta.text}
                />
              </div>
              <div class="mt-12 flex w-full items-center gap-0 pr-6 lg:pr-10">
                <svg class="h-2 min-w-0 flex-1 overflow-visible" aria-hidden="true">
                  <line
                    x1="0"
                    y1="4"
                    x2="100%"
                    y2="4"
                    stroke="var(--color-primary)"
                    stroke-width="2"
                  />
                </svg>
                <svg
                  class="h-2.5 w-2.5 shrink-0"
                  viewBox="0 0 10 10"
                  aria-hidden="true"
                >
                  <circle cx="5" cy="5" r="4.5" fill="var(--color-primary)" />
                </svg>
                <BookButton
                  currentLang="es"
                  text={final_cta.button_text}
                  className="ml-5"
                />
              </div>
            </section>
          )}
        </>
      )
    }
  </main>
  <SiteFooter currentLang="es" homePrefix="/" />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
</Layout>

  <script is:inline>
    document.addEventListener('astro:page-load', () => {
      if (typeof trackMetaEvent === 'function') {
        trackMetaEvent('ViewContent', {
          content_name: document.title,
          content_category: 'service',
          content_type: 'product'
        });
      }
    });
  </script>

<style is:global>
  /* Prosa del modo legacy (body markdown de la colección) */
  .legacy-prose :where(h2, h3, h4) {
    font-family: var(--font-display);
    color: var(--color-text);
    border-top: 1px solid var(--color-hairline);
    margin-top: 2.75rem;
    padding-top: 1.25rem;
    font-size: 1.5rem;
    line-height: 1.2;
  }
  .legacy-prose :where(p) {
    margin-top: 1.25rem;
    color: var(--color-text-dark);
    font-size: 1.0625rem;
    line-height: 1.75;
    max-width: 65ch;
  }
  .legacy-prose :where(ul, ol) {
    margin-top: 1.25rem;
    padding-left: 1.5rem;
    color: var(--color-text-dark);
  }
  .legacy-prose :where(li) {
    margin-top: 0.5rem;
    line-height: 1.75;
  }
  .legacy-prose :where(strong) {
    color: var(--color-text);
  }
  .legacy-prose :where(a) {
    color: var(--color-text);
    text-underline-offset: 3px;
    transition: color 0.2s ease;
  }
  .legacy-prose :where(a:hover) {
    color: var(--color-primary);
  }
</style>
