---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getLanguageFromURL, useTranslations, getAlternateURLs } from "../i18n/utils";
import { defaultLanguage } from "../i18n/config";
import StructuredData from "../components/StructuredData.astro";
import MetaPixel from "../components/MetaPixel.astro";
import CookiebotConsent from "../components/layout/CookiebotConsent.astro";
import GoogleTagManager from "../components/layout/GoogleTagManager.astro";
import GoogleTagManagerBody from "../components/layout/GoogleTagManagerBody.astro";

const gtmId = import.meta.env.GTM_ID;

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  // La home v4 monta su propio header/footer (sections/SiteHeader + SiteFooter);
  // el resto de páginas siguen usando el chrome v1 de este layout.
  chrome?: boolean;
}

const {
  title,
  description,
  ogImage = "/logoEnteroOG.png",
  chrome = true,
} = Astro.props;
const currentLang = getLanguageFromURL(Astro.url);
const t = useTranslations(currentLang);
const alternateURLs = getAlternateURLs(Astro.url.pathname, currentLang);

// Create proper page title
const siteTitle = "Logic & Lines";
const fullTitle =
  title === "main" || title === "principal"
    ? siteTitle
    : `${title} | ${siteTitle}`;

// Default description if none provided
const metaDescription =
  description ||
  (currentLang === "en"
    ? "Logic & Lines: Marketing & AI Automation Agency. We transform businesses through advanced digital strategies and intelligent automation."
    : "Logic & Lines: Agencia de Marketing y Automatización con IA. Transformamos negocios mediante estrategias digitales avanzadas y automatización inteligente.");

// Canonical URL
const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site || "https://logicandlines.com",
);
---

<!doctype html>
<html lang={currentLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/logoSolo.svg?v=2" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="google-site-verification"
      content="93bXGfrbTzfsg5eqg_RvRBCIVYqGd_IWJrrpBLEDiTc"
    />
    <!-- tagg de facebook -->
    <meta name="facebook-domain-verification" content="vmlz8ifxftyh1xc26nb5obdokf4kf6" />

    <!-- Primary Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={metaDescription} />
    <meta
      name="keywords"
      content="marketing agency, AI automation, business automation, digital marketing, artificial intelligence, agencias de marketing, automatización de negocios, inteligencia artificial, consultoría IA, Logic & Lines, crecimiento de negocios, ganar más clientes, estrategias de crecimiento empresarial, captación de clientes, escalar ventas con IA, generación de leads, optimización de ingresos, growth marketing, automatización de ventas, transformación digital"
    />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta
      property="og:image"
      content={new URL(ogImage, Astro.site || "https://logicandlines.com")}
    />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={fullTitle} />
    <meta property="twitter:description" content={metaDescription} />
    <meta
      property="twitter:image"
      content={new URL(ogImage, Astro.site || "https://logicandlines.com")}
    />

    <ClientRouter />
    <!-- Self-hosted faces (v4 F0): preload the two most critical ones.
         crossorigin="anonymous" en el preload + crossorigin: anonymous en
         el @font-face correspondiente: ambos pasan a credentials mode
         "same-origin" y CORS mode "cors", y los modos casan (sin esto,
         Chrome emite "preloaded but not used because the request
         credentials mode does not match"). Para same-origin, no hace
         falta Access-Control-Allow-Origin (Chrome acepta la respuesta sin
         handshake CORS); sólo sirve para alinear los modos.
         data-astro-transition-persist: sin él, cada navegación soft del
         ClientRouter elimina estos <link> y los reinserta como nodos nuevos
         (swapHeadElements solo conserva link[rel=stylesheet]), y Chrome
         avisa "preloaded but not used" porque las caras ya están cargadas.
         Con el atributo, el nodo consumido sobrevive al swap. -->
    <link rel="preload" href="/fonts/sentient-400.woff2" as="font" type="font/woff2" crossorigin="anonymous" data-astro-transition-persist="ll-font-sentient-400" />
    <link rel="preload" href="/fonts/cabinet-grotesk-400.woff2" as="font" type="font/woff2" crossorigin="anonymous" data-astro-transition-persist="ll-font-cabinet-grotesk-400" />

    <!-- Hreflang tags for multilingual SEO -->
    <link rel="alternate" hreflang={currentLang} href={`https://logicandlines.com${alternateURLs[currentLang]}`} />
    {
      Object.entries(alternateURLs)
        .filter(([lang]) => lang !== currentLang)
        .map(([lang, url]) => (
          <link rel="alternate" hreflang={lang} href={`https://logicandlines.com${url}`} />
        ))
    }
    <link rel="alternate" hreflang="x-default" href={`https://logicandlines.com${alternateURLs[defaultLanguage]}`} />

    <CookiebotConsent />
    <GoogleTagManager />
    <MetaPixel />
  </head>
  <body>
    <GoogleTagManagerBody />
    {chrome && <Header currentLang={currentLang} />}
    <slot />
    {chrome && <Footer currentLang={currentLang} />}
    <StructuredData currentLang={currentLang} />
    <!-- Motion system (v4 F0 skeleton: plugins, tokens, Lenis). Bundled by Astro;
         re-runs its setup on astro:page-load after each ClientRouter swap. -->
    <script>
      import { initMotion } from "../scripts/motion/index.ts";
      initMotion();
    </script>
    <script is:inline>
      document.addEventListener('click', function (e) {
        var el = e.target.closest('[data-gtm-event]');
        if (!el) return;
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({
          event: el.dataset.gtmEvent,
          gtm_location: el.dataset.gtmLocation || '',
          gtm_label: el.dataset.gtmLabel || '',
          url: el.href || '',
        });
      });
    </script>
  </body>
</html>

<style>
  html,
  body {
    background-color: var(--color-bg);
    font-family: var(--font-sans);
    margin: 0;
    color: var(--color-text);
    /* R6: era overflow-x: hidden. `hidden` en un ancestro crea scroll
     * container y degrada el scroll gestionado por Lenis/pins (además de
     * romper cualquier position: sticky futuro). `clip` corta el overflow
     * horizontal igual pero NO crea contenedor de scroll. El motivo hoy es el
     * SLIDE HORIZONTAL de la sección de servicios (hscroll.ts la saca
     * xPercent -100 al final de su pin: overflow izquierdo que no genera
     * scrollbar, pero el clip es el cinturón para cualquier deriva futura). */
    overflow-x: clip;
  }
  /* antes: height: 100% + justify-items: center. height: 100% capaba
   *html y body a la altura del viewport; con overflow capado, html se
   *volvía overflow-y:auto pero su contenido (capado a 100% también)
   *nunca crecía, así que el scroll del documento quedaba en 0. El
   *IntersectionObserver de loading="lazy" mide el viewport real, así que
   *ninguna imagen fuera de 100vh entraba en viewport y nunca se pedían
   *los woff2/png posteriores. Ahora html crece con body y html es el
   *scroll container único (window.scrollY). justify-items: center era
   *código muerto sin grid/flex context.
   */
</style>
