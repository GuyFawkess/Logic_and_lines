---
const pixelId = import.meta.env.PUBLIC_META_PIXEL_ID;
---

{pixelId && (
  <!-- Meta Conversions API helpers: deduplicacion con event_id compartido -->
  <!-- El script base de Meta Pixel (fbevents.js) lo carga GTM, no este componente -->
  <script is:inline>
    window.generateMetaEventId = function () {
      if (typeof crypto !== 'undefined' && typeof crypto.randomUUID === 'function') {
        return 'evt_' + crypto.randomUUID();
      }
      return 'evt_' + Date.now() + '_' + Math.random().toString(36).slice(2, 11);
    };

    window.getMetaFbcCookie = function () {
      var match = document.cookie.match(/_fbc=([^;]+)/);
      return match ? match[1] : null;
    };

    window.getMetaFbpCookie = function () {
      var match = document.cookie.match(/_fbp=([^;]+)/);
      return match ? match[1] : null;
    };

    window.sendToMetaCAPI = async function (eventName, eventId, customData, userData) {
      var payload = {
        event_name: eventName,
        event_time: Math.floor(Date.now() / 1000),
        action_source: 'website',
        event_id: eventId,
        user_data: Object.assign({}, userData || {}, {
          client_user_agent: navigator.userAgent,
          fbc: window.getMetaFbcCookie(),
          fbp: window.getMetaFbpCookie()
        }),
        custom_data: customData || {}
      };

      try {
        await fetch('/api/track', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
      } catch (err) {
        console.warn('[Meta CAPI] Error sending event:', err);
      }
    };

    window.trackMetaEvent = function (eventName, customData, userData) {
      var eventId = window.generateMetaEventId();

      // Si GTM ya cargó fbq, disparamos el evento browser-side con el mismo event_id
      if (typeof fbq !== 'undefined') {
        fbq('track', eventName, customData || {}, { eventID: eventId });
      }

      // Siempre enviamos via CAPI server-side para deduplicación
      window.sendToMetaCAPI(eventName, eventId, customData, userData);
    };
  </script>
)}
