---
// Cierre / Booking (F1): el pico estático. La Línea Maestra cruza la sección a
// sangre y cierra circuito en el CTA de Cal.com (embed exacto del Booking v1).
// Hora local de Lanzarote calculada en el render.
// F3-v2 tanda 3 (pico peak-end): el motion vive en src/scripts/motion/circuit.ts
// (pin + driver único, cierre de circuito con viajero, pop del nodo, flash del
// CTA y blur-reveal del claim). Aquí solo el markup: svg del bucle + nodo
// (estado FINAL en markup, regla de oro sin-JS) y min-h en lg para que el pin
// tenga escenario de viewport completo (sin él, durante el pin se vería una
// banda del fondo de página bajo la sección). lg:flex + lg:justify-center
// centran el lockup en vertical dentro de ese escenario (el pico se lee en el
// centro del viewport; circuit.ts sigue pineando el section, sin cambios).
import { useTranslations } from "../../i18n/utils";
import CircuitDetail from "../decor/CircuitDetail.astro";
import { formatLanzaroteTime } from "../../lib/time";

interface Props {
  currentLang: "es" | "en";
}

const { currentLang } = Astro.props;
const t = useTranslations(currentLang);
const lanzaroteTime = formatLanzaroteTime(currentLang);
const email = "logicandlinestudios@gmail.com";
---

<section
  id="booking"
  data-circuit
  class="relative w-full overflow-hidden border-t border-(--color-hairline) bg-(--color-bg-alt) py-24 lg:pb-5 lg:pt-[4.5rem] lg:min-h-[100svh] lg:flex lg:flex-col lg:justify-center"
>
  <CircuitDetail variant="c" side="left" style="top:5rem;width:min(200px, calc((100% - 920px) / 2 - 16px));" />

  <!-- R2 (rediseño del cierre): lockup centrado y contenido (max 920px).
       Claim serif en 2 líneas + sub muted, y el CTA como lockup único: el
       racetrack ámbar cierra ALREDEDOR del botón (el botón vive DENTRO del
       circuito, como terminación del recorrido del viajero) con los nodos
       como terminales a izquierda/derecha del track. circuit.ts no cambia:
       selecciona [data-circuit-row]/[data-circuit-path]/[data-node]/CTA por
       data-attribute y MotionPath alinea en el espacio del parentNode. -->
  <div class="mx-auto w-full max-w-[920px] px-6 text-center lg:px-10">
    {/* Closing h2 runs larger on purpose (peak-end hierarchy): this headline
        closes the page. Sin data-reveal: el claim usa el blur-reveal de
        chars del pico (circuit.ts, técnica 6 del catálogo), no el reveal por
        líneas de F2. Escala pico: max-w-[16ch] + clamp(2.75rem→7rem) lo
        parte en 2 líneas a cualquier ancho y lo erige como mayor tamaño
        tipográfico de la página. */}
    <h2
      class="mx-auto max-w-[16ch] font-display text-[clamp(2.75rem,7vw,7rem)] leading-[0.98] tracking-[-0.05em] text-(--color-text)"
      set:html={t.booking.title}
    />
    <p class="mx-auto mt-6 max-w-[46ch] text-lg leading-relaxed text-(--color-text-dark)">
      {t.booking.text}
    </p>
  </div>

  <!-- Lockup del circuito: píldora con aspect 5/1 FIJO por CSS → el svg con
       preserveAspectRatio="none" escala UNIFORME a cualquier ancho (la
       cápsula nunca se deforma) y vector-effect mantiene el trazo a 1.5px.
       El path empieza y TERMINA en el terminal izquierdo (8,64): DrawSVG
       0→100% dibuja la vuelta completa y el viajero se suelda en el nodo de
       cierre (mismo comportamiento que el racetrack anterior — circuit.ts
       intacto). El botón se centra por LAYOUT (inset + margin auto: nunca
       translate en un elemento que toca GSAP — lección Morning Ritual). -->
  <div class="mx-auto mt-14 w-full max-w-[720px] px-6">
    <div class="relative aspect-[5/1] w-full" data-circuit-row>
      <svg
        class="pointer-events-none absolute inset-0 h-full w-full overflow-visible"
        viewBox="0 0 640 128"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <path
          data-circuit-path
          d="M8 64 C8 28.65 36.65 0 72 0 L568 0 C603.35 0 632 28.65 632 64 C632 99.35 603.35 128 568 128 L72 128 C36.65 128 8 99.35 8 64 Z"
          fill="none"
          stroke="var(--color-primary)"
          stroke-width="1.5"
          vector-effect="non-scaling-stroke"></path>
      </svg>
      <!-- Terminal izquierdo: el nodo de cierre (pop + anillo al llegar el
           viajero). Centrado con translate sobre el svg padre; GSAP anima el
           circle hijo, así que el centrado es inmune (lección Morning
           Ritual). Posición exacta del vértice: 8/640 = 1.25%. -->
      <svg
        class="pointer-events-none absolute left-[1.25%] top-1/2 h-3 w-3 -translate-x-1/2 -translate-y-1/2 overflow-visible"
        viewBox="0 0 12 12"
        aria-hidden="true"
      >
        <circle data-node cx="6" cy="6" r="4.5" fill="var(--color-primary)"></circle>
      </svg>
      <!-- Terminal derecho: dot estático (sin JS). R3-6: simétrico EXACTO del
           izquierdo — right:1.25% clava el BORDE derecho del svg en 98.75% de
           la fila; para que el CENTRO del circle caiga ahí (igual que el
           izquierdo en 1.25%), el svg se desplaza +50% de su ancho (espejo
           del -translate-x-1/2 izquierdo: con -50% el dot quedaba ~10px
           DENTRO del vértice — la asimetría que se leía como "CTA
           descentrado" en captura; el botón medía 0.00px de error). -->
      <svg
        class="pointer-events-none absolute right-[1.25%] top-1/2 h-2.5 w-2.5 translate-x-1/2 -translate-y-1/2"
        viewBox="0 0 10 10"
        aria-hidden="true"
      >
        <circle cx="5" cy="5" r="4.5" fill="var(--color-primary)"></circle>
      </svg>
      <!-- R3-6 (verificación estática del descentrado ~28px del botón):
           el markup es SIMÉTRICO y el centrado es exacto — inset-0 + m-auto
           con w-fit centra el botón al píxel (0.00px de error ya medido en
           R2), los dos terminales caen en ±1.25% con dots de 9px, el path es
           simétrico (vértices a 8/640 y 632/640 del viewBox) y no hay hijo
           extra del row que desplace (los 4 hijos + el viajero de circuit.ts
           son absolute). NADA que arreglar en markup/CSS. Hipótesis para la
           medición del QA en vivo: (1) el embed de Cal.com muta el botón en
           runtime (inyecta estilos/atributos sobre [data-cal-link]); (2) la
           medida se tomó con el hover-roll activo (capa duplicada del label);
           (3) offset óptico del scrollbar (~8-17px) leído como ~28px; (4)
           referencia de medida contra el CLAIM (h2 max-w-[16ch]) en vez de
           contra el row — ambos están centrados en el mismo eje, pero un
           subcadena del h2 puede parecer descentrada. -->
      <!-- ⚠️ flex items-center OBLIGATORIO: el hover-roll (F4) envuelve el
           texto en un span label (overflow:hidden + capa 2 absolute left:0).
           Si el botón no es flex, el span queda INLINE (block-in-inline) y
           left:0 de la capa 2 se resuelve contra un fragmento desplazado →
           el texto se DUPLICA visible bajo el botón. El flex blockifica el
           span y el clip vuelve a ser exacto (era el estado del botón v1). -->
      <!-- CTA v2 (2026-10-28): píldora ámbar + chip circular petróleo con
           flecha a la derecha + anillo hairline ámbar a 5px (::after). El
           label es el PRIMER <span> del botón (hover-roll.ts resuelve el
           label con querySelector("span"): el chip va DESPUÉS). -->
      <button
        type="button"
        class="cta-lockup-btn absolute inset-0 m-auto flex h-11 w-fit shrink-0 items-center justify-center gap-3 whitespace-nowrap rounded-full bg-(--color-primary) pl-7 pr-2 text-base font-medium text-(--color-bg) hover:bg-(--color-primary-hover) focus-visible:outline-none lg:h-14 lg:gap-4 lg:pl-9 lg:pr-2.5 lg:text-lg"
        data-gtm-event="schedule_click"
        data-gtm-location="booking_section"
        data-gtm-label="cal_evaluation_call"
        data-cal-link="logic-and-lines-knzt9s/1ª-llamada-de-evaluacion"
        data-cal-namespace="1ª-llamada-de-evaluacion"
        data-cal-config='{"layout":"month_view","useSlotsViewOnSmallScreen":"true","theme":"dark"}'
      >
        <span>{t.booking.button}</span>
        <span
          class="cta-lockup-chip flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-(--color-bg) text-(--color-primary) lg:h-9 lg:w-9"
          aria-hidden="true"
        >
          <svg class="cta-lockup-arrow h-3.5 w-3.5 lg:h-4 lg:w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2.5 8h11M9 3.5 13.5 8 9 12.5"></path>
          </svg>
        </span>
      </button>
    </div>
  </div>

  <div class="mx-auto w-full max-w-[920px] px-6 lg:px-10">
    <!-- Nota del lockup: mono pequeño centrada bajo el circuito. -->
    <p class="mt-8 text-center font-mono text-xs tabular-nums text-(--color-text-dark)">
      {t.booking.footer}
    </p>

    <!-- Canales directos + hora local (centrados: composición del lockup). -->
    <div class="mt-10 flex flex-wrap items-center justify-center gap-x-10 gap-y-4">
      <a
        href="https://wa.me/34628125302"
        target="_blank"
        rel="noopener"
        class="inline-flex min-h-11 items-center text-sm font-medium text-(--color-text) underline underline-offset-4 transition-colors duration-200 hover:text-(--color-primary)"
        data-gtm-event="contact_click"
        data-gtm-location="booking_section"
        data-gtm-label="whatsapp"
      >
        <span>WhatsApp</span>
      </a>
      <a
        href={`mailto:${email}`}
        class="inline-flex min-h-11 items-center text-sm font-medium text-(--color-text) underline underline-offset-4 transition-colors duration-200 hover:text-(--color-primary)"
        data-gtm-event="contact_click"
        data-gtm-location="booking_section"
        data-gtm-label="email"
      >
        <span>{email}</span>
      </a>
      <p class="font-mono text-xs tabular-nums text-(--color-text-dark)">
        <span>LANZAROTE</span>
        <!-- Hora congelada en build = fallback sin-JS; local-time.ts la
             actualiza cada 30s (F4). -->
        <time data-local-time data-local-time-lang={currentLang}
          >{lanzaroteTime}</time
        >
      </p>
    </div>
  </div>

  <style>
    /* Micro-interacción del CTA (R2): lift 2px + cambio de color en hover,
       sin glow: el ámbar tiene un único dueño; presión con scale en active.
       Transiciones de propiedades EXACTAS (nunca "all"), curva ease-out
       fuerte, y el hover gated a puntero fino (los táctiles disparan hover en
       el tap). El flash del viajero (circuit.ts) anima backgroundColor inline
       y al completar hace clearProps: convive con esta transition sin
       conflicto. */
    .cta-lockup-btn {
      transition:
        transform 160ms cubic-bezier(0.23, 1, 0.32, 1),
        background-color 200ms ease;
    }
    /* Anillo hairline (CTA v2): 1px ámbar a 5px del botón, sólido (sin glow).
       En hover se abre ~3px por lado (scale no uniforme ≈ px iguales en X/Y
       para la proporción del botón) y gana opacidad; en focus-visible pasa a
       marfil 2px opaco = anillo de foco claro sobre el fondo y el ámbar. */
    .cta-lockup-btn::after {
      content: "";
      position: absolute;
      inset: -5px;
      border: 1px solid var(--color-primary);
      border-radius: 9999px;
      opacity: 0.45;
      pointer-events: none;
      transition:
        transform 240ms cubic-bezier(0.23, 1, 0.32, 1),
        opacity 200ms ease;
    }
    .cta-lockup-btn:focus-visible::after {
      border: 2px solid var(--color-text);
      opacity: 1;
    }
    .cta-lockup-arrow {
      transition: transform 240ms cubic-bezier(0.23, 1, 0.32, 1);
    }
    .cta-lockup-btn:active {
      transform: translateY(0) scale(0.98);
    }
    @media (hover: hover) and (pointer: fine) {
      .cta-lockup-btn:hover {
        transform: translateY(-2px);
      }
      .cta-lockup-btn:hover::after {
        transform: scale(1.02, 1.09);
        opacity: 1;
      }
      .cta-lockup-btn:hover .cta-lockup-arrow {
        transform: translateX(3px);
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .cta-lockup-btn {
        transition: background-color 200ms ease;
      }
      .cta-lockup-btn::after,
      .cta-lockup-arrow {
        transition: opacity 200ms ease;
      }
      .cta-lockup-btn:hover,
      .cta-lockup-btn:active,
      .cta-lockup-btn:hover::after,
      .cta-lockup-btn:hover .cta-lockup-arrow {
        transform: none;
      }
    }
  </style>

  <!-- Cal element-click embed code begins -->
  <script type="text/javascript">
    (function (C, A, L) {
      let p = function (a, ar) {
        a.q.push(ar);
      };
      let d = C.document;
      C.Cal =
        C.Cal ||
        function () {
          let cal = C.Cal;
          let ar = arguments;
          if (!cal.loaded) {
            cal.ns = {};
            cal.q = cal.q || [];
            d.head.appendChild(d.createElement("script")).src = A;
            cal.loaded = true;
          }
          if (ar[0] === L) {
            const api = function () {
              p(api, arguments);
            };
            const namespace = ar[1];
            api.q = api.q || [];
            if (typeof namespace === "string") {
              cal.ns[namespace] = cal.ns[namespace] || api;
              p(cal.ns[namespace], ar);
              p(cal, ["initNamespace", namespace]);
            } else p(cal, ar);
            return;
          }
          p(cal, ar);
        };
    })(window, "https://app.cal.com/embed/embed.js", "init");
    Cal("init", "1ª-llamada-de-evaluacion", {
      origin: "https://app.cal.com",
    });

    Cal.ns["1ª-llamada-de-evaluacion"]("ui", {
      theme: "dark",
      cssVarsPerTheme: { light: { "cal-brand": "#0D1A1F" } },
      hideEventTypeDetails: false,
      layout: "month_view",
    });

    Cal.ns["1ª-llamada-de-evaluacion"]("on", {
      action: "bookingSuccessful",
      callback: function () {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: "generated_lead" });
      },
    });
  </script>
  <!-- Cal element-click embed code ends -->

  <!-- Meta Pixel: evento Schedule al pulsar el botón de Cal.com -->
  <script is:inline>
    document.addEventListener('astro:page-load', () => {
      const calButton = document.querySelector('[data-cal-link]');
      if (calButton) {
        calButton.addEventListener('click', () => {
          if (typeof trackMetaEvent === 'function') {
            trackMetaEvent('Schedule', {
              content_name: 'cal_booking',
              content_category: 'scheduling'
            });
          }
        });
      }
    });
  </script>
</section>
