---
// Footer v4 (F1): nav de anclas, Instagram, legales, © del año y hora local
// de Lanzarote. Sin emojis. Enlaces simples a > span (F4 les añade el roll
// por JS).
// P1-4 (esta tanda): el wordmark deja de ser un logo de 24px y pasa a ser el
// cierre de la página — a todo el ancho, hecho de líneas horizontales
// estáticas, bajo los enlaces (referencia docs/research-v4/trionn-04-footer.jpeg).
import { useTranslations } from "../../i18n/utils";
import { Icon } from "astro-icon/components";
import CircuitDetail from "../decor/CircuitDetail.astro";
import { formatLanzaroteTime } from "../../lib/time";

interface Props {
  currentLang: "es" | "en";
  // Prefijo de la home para las anclas de sección (ver SiteHeader). En la home
  // se deja vacío; las subpáginas pasan "/" o "/en/".
  homePrefix?: string;
}

const { currentLang, homePrefix = "" } = Astro.props;
const t = useTranslations(currentLang);
const isEn = currentLang === "en";
const year = new Date().getFullYear();
const lanzaroteTime = formatLanzaroteTime(currentLang);
const copyright = (t.footer.copyright as string).replace(
  "{year}",
  String(year),
);

const homeHref = isEn ? "/en/" : "/";
const contactHref = isEn ? "/en/contact" : "/contact";
const privacyHref = isEn ? "/en/privacy-policy" : "/politica-de-privacidad";
const langHref = isEn ? "/" : "/en/";
const langLabel = isEn ? "ES" : "EN";

const navLinks = [
  { href: homeHref, label: t.footer.home },
  { href: `${homePrefix}#servicios`, label: t.nav.services },
  { href: `${homePrefix}#proceso`, label: t.nav.process },
  { href: `${homePrefix}#razones`, label: t.nav.reason },
  { href: `${homePrefix}#faq`, label: t.nav.faq },
  { href: contactHref, label: t.footer.contact },
];
---

<footer class="relative w-full border-t border-(--color-hairline) bg-(--color-bg)">
  <CircuitDetail variant="b" side="right" style="top:1.5rem;width:120px;" />
  <div class="mx-auto w-full max-w-[1400px] px-6 pb-6 pt-10 lg:px-10 lg:pt-12">
    <!-- v2: rejilla de 12 col en lg (nav 5 / conecta 4 / legal+hora 3), una sola
         escala de espacio (gap-8 entre bloques, gap-4 dentro). Cada bloque abre
         con una cabecera mono pequeña para que las tres columnas alineen. -->
    <div class="grid grid-cols-2 gap-x-6 gap-y-8 lg:flex lg:items-start lg:justify-between lg:gap-x-12">
      <!-- Navegación: 2 sub-columnas (3 filas) -->
      <nav
        aria-label={isEn ? "Footer" : "Pie de página"}
        class="col-span-2"
      >
        <p class="font-mono text-xs uppercase tracking-[0.08em] text-(--color-text-dark)">
          {isEn ? "Explore" : "Navegar"}
        </p>
        <ul class="mt-2 grid grid-flow-col grid-cols-[auto_auto] grid-rows-3 justify-start gap-x-10 lg:gap-x-12">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="inline-flex min-h-11 min-w-11 items-center text-sm text-(--color-text) transition-colors duration-200 hover:text-(--color-primary) lg:min-h-9 lg:min-w-0"
                >
                  <span>{link.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Conecta: botones-icono -->
      <div class="col-span-2">
        <p class="font-mono text-xs uppercase tracking-[0.08em] text-(--color-text-dark)">
          {isEn ? "Connect" : "Conecta"}
        </p>
        <div class="mt-4 flex flex-wrap gap-4">
          <a
            href="https://www.instagram.com/logic_and_lines/?hl=en"
            target="_blank"
            rel="noopener"
            aria-label="Instagram"
            data-no-roll
            class="group inline-flex size-11 items-center justify-center rounded-xl border border-(--color-hairline) text-(--color-text-dark) transition-colors duration-200 hover:border-(--color-primary) hover:text-(--color-primary)"
            data-gtm-event="social_click"
            data-gtm-location="footer"
            data-gtm-label="instagram"
          >
            <Icon name="instagram" class="h-5 w-5" />
          </a>
          <a
            href="mailto:logicandlinestudios@gmail.com"
            aria-label="Email"
            data-no-roll
            class="group inline-flex size-11 items-center justify-center rounded-xl border border-(--color-hairline) text-(--color-text-dark) transition-colors duration-200 hover:border-(--color-primary) hover:text-(--color-primary)"
            data-gtm-event="contact_click"
            data-gtm-location="footer"
            data-gtm-label="email"
          >
            <Icon name="gmail2" class="h-5 w-5" />
          </a>
          <a
            href="https://wa.me/34628125302"
            target="_blank"
            rel="noopener"
            aria-label="WhatsApp"
            data-no-roll
            class="group inline-flex size-11 items-center justify-center rounded-xl border border-(--color-hairline) text-(--color-text-dark) transition-colors duration-200 hover:border-(--color-primary) hover:text-(--color-primary)"
            data-gtm-event="contact_click"
            data-gtm-location="footer"
            data-gtm-label="whatsapp"
          >
            <Icon name="whatsapp" class="h-5 w-5" />
          </a>
        </div>
      </div>

      <!-- Hora local (cabecera) + legal -->
      <div class="col-span-2 lg:pr-24">
        <p
          class="font-mono uppercase tracking-[0.08em] tabular-nums text-sm lg:text-xs text-(--color-text-dark)"
        >
          <span>LANZAROTE</span>
          <!-- Hora congelada en build = fallback sin-JS; local-time.ts la
               actualiza cada 30s (F4). -->
          <time data-local-time data-local-time-lang={currentLang}
            >{lanzaroteTime}</time
          >
        </p>
        <ul class="mt-2 flex flex-col">
          <li>
            <a
              href={privacyHref}
              class="inline-flex min-h-11 min-w-11 items-center text-sm text-(--color-text) transition-colors duration-200 hover:text-(--color-primary) lg:min-h-9 lg:min-w-0"
            >
              <span>{t.privacy.link}</span>
            </a>
          </li>
          <li>
            <a
              href="#"
              data-cookieconsent="ignore"
              onclick="if(window.Cookiebot){window.Cookiebot.renew()}return false;"
              class="inline-flex min-h-11 min-w-11 items-center text-sm text-(--color-text) transition-colors duration-200 hover:text-(--color-primary) lg:min-h-9 lg:min-w-0"
            >
              <span>{t.privacy.cookies}</span>
            </a>
          </li>
          <li>
            <a
              href={langHref}
              class="inline-flex min-h-11 min-w-11 items-center text-sm text-(--color-text) transition-colors duration-200 hover:text-(--color-primary) lg:min-h-9 lg:min-w-0"
              data-gtm-event="language_switch"
              data-gtm-location="footer"
              data-gtm-label={isEn ? "es" : "en"}
            >
              <span>{langLabel}</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- P1-4: wordmark de cierre a todo el ancho hecho de líneas estáticas
         (referencia docs/research-v4/trionn-04-footer.jpeg). La máscara (3px de
         tinta / 4px de hueco) vive en el CSS del componente: es ESTÁTICA, no
         animada. Los márgenes negativos hacen bleed (como en Trionn) para que
         el clamp de 13.5vw quepa dentro de la caja y la página no desborde. -->
    <p
      class="ll-footer-wordmark -mx-6 mt-8 whitespace-nowrap font-display uppercase text-[clamp(3rem,13.5vw,12.5rem)] leading-[0.85] tracking-[-0.03em] text-(--color-text) lg:-mx-10"
    >
      Logic &amp; Lines
    </p>

    <!-- v2: el © cierra el pie, bajo el wordmark -->
    <div
      class="mt-8 border-t border-(--color-hairline) pt-4 text-sm text-(--color-text-dark)"
    >
      <p>{copyright}</p>
    </div>
  </div>

  <!-- Meta Pixel: eventos de contacto por canal (mismo listener que el footer v1) -->
  <script is:inline>
    document.addEventListener('astro:page-load', () => {
      if (typeof trackMetaEvent === 'function') {
        document.querySelectorAll('a[href^="mailto:"]').forEach(link => {
          link.addEventListener('click', () => {
            trackMetaEvent('Contact', {
              content_name: 'email',
              contact_type: 'email'
            });
          });
        });

        document.querySelectorAll('a[href^="https://wa.me/"]').forEach(link => {
          link.addEventListener('click', () => {
            trackMetaEvent('Contact', {
              content_name: 'whatsapp',
              contact_type: 'whatsapp'
            });
          });
        });

        document.querySelectorAll('a[href*="instagram.com"]').forEach(link => {
          link.addEventListener('click', () => {
            trackMetaEvent('Contact', {
              content_name: 'instagram',
              contact_type: 'instagram'
            });
          });
        });
      }
    });
  </script>

  <style>
    /* Wordmark de cierre (P1-4): el logotipo a todo el ancho hecho de líneas
       horizontales (docs/research-v4/trionn-04-footer.jpeg). La máscara es un
       gradiente repetido — 3px de tinta, 4px de hueco — ESTÁTICO: ni una
       animación ni un hex nuevo (el #000 es opacidad de máscara, no color). */
    .ll-footer-wordmark {
      -webkit-mask-image: repeating-linear-gradient(
        to bottom,
        #000 0 3px,
        transparent 3px 7px
      );
      mask-image: repeating-linear-gradient(
        to bottom,
        #000 0 3px,
        transparent 3px 7px
      );
    }
  </style>
</footer>
