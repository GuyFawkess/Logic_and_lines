---
// Pruebas (F2): dos actos en una sección. (a) stats reales en fila alineada
// con hairlines verticales (sin cards); (b) razones en grid 2x2 con columnas
// iguales para que las reglas horizontales queden alineadas. Sin iconos.
// (F2: se eliminan los offsets escalonados de F1 por feedback del usuario.)
// (F3-v2: count-up de cifras + subrayado ámbar dibujado — line-system.ts.)
import { useTranslations } from "../../i18n/utils";

interface Props {
  currentLang: "es" | "en";
}

const { currentLang } = Astro.props;
const t = useTranslations(currentLang);
const stats = t.stats.items as Array<{ value: string; label: string }>;
const reasons = t.reasons.items as string[];
---

<section id="razones" class="mx-auto w-full max-w-[1400px] px-6 lg:px-10">
  <h2
    class="pt-24 font-display text-[clamp(2rem,4.5vw,3.5rem)] leading-[1.12] tracking-[-0.04em] text-(--color-text) lg:pt-32"
    data-reveal="lines"
  >
    {t.reasons.title}
  </h2>

  <!-- (a) Cifras: datos reales, tabulares, fila alineada. F3-v2: count-up +
       subrayado ámbar dibujado (line-system.ts). El markup parte del estado
       FINAL (valor final, regla dibujada): es el JS quien lo prepara. -->
  <ul class="mt-16 grid grid-cols-1 gap-y-10 sm:grid-cols-3" data-stats>
    {
      stats.map((stat) => (
        <li class="border-t border-(--color-hairline) pt-6 sm:border-l sm:border-t-0 sm:pl-8 sm:pt-0 sm:first:border-l-0 sm:first:pl-0">
          <p
            class="font-display text-[clamp(2.5rem,6vw,4.5rem)] leading-none tabular-nums text-(--color-text)"
            data-stat-value
          >
            {stat.value}
          </p>
          <svg class="mt-3 block h-0.5 w-full" aria-hidden="true" data-underline>
            <line x1="0" y1="1" x2="100%" y2="1" class="stroke-(--color-primary)" stroke-width="2" />
          </svg>
          <p class="mt-3 font-mono text-sm leading-relaxed text-(--color-text-dark)">
            {stat.label}
          </p>
        </li>
      ))
    }
  </ul>

  <!-- (b) Razones: grid 2x2 con columnas iguales, reglas alineadas -->
  <ul class="mt-20 grid grid-cols-1 gap-x-12 gap-y-10 md:grid-cols-2">
    {
      reasons.map((reason) => (
        <li class="border-t border-(--color-hairline) pt-5">
          <p class="font-display text-xl leading-snug text-(--color-text) md:text-2xl">
            {reason}
          </p>
        </li>
      ))
    }
  </ul>
</section>
