---
// Proceso (F1): la Línea Maestra manda. Raíl vertical SVG estático con 4 nodos;
// cada paso cuelga de su nodo (número mono de secuencia, título, descripción).
// Los tramos de línea de cada paso se encadenan en una sola línea continua.
import { useTranslations } from "../../i18n/utils";

interface Props {
  currentLang: "es" | "en";
}

const { currentLang } = Astro.props;
const t = useTranslations(currentLang);
const steps = t.process.steps as Array<{
  step: string;
  title: string;
  description: string;
}>;
---

<section id="proceso" class="mx-auto w-full max-w-[1400px] px-6 lg:px-10">
  <h2
    class="pt-24 font-display text-[clamp(2rem,4.5vw,3.5rem)] leading-[1.12] tracking-[-0.04em] text-(--color-text) lg:pt-32"
  >
    {t.process.title}
  </h2>

  <ol class="mt-14">
    {
      steps.map((s, i) => {
        const isLast = i === steps.length - 1;
        return (
          <li class="relative pb-12 last:pb-0 md:pb-16">
            {/* Nodo + tramo de línea del paso (SVG nativo, sin animación) */}
            <svg
              class="pointer-events-none absolute left-0 top-0 h-full w-2 overflow-visible"
              aria-hidden="true"
            >
              <line
                x1="3"
                y1="0"
                x2="3"
                y2={isLast ? "8" : "100%"}
                stroke="var(--color-primary)"
                stroke-width="2"
              />
              <circle cx="3" cy="8" r="5" fill="var(--color-primary)" />
            </svg>

            <div class="pl-10 md:pl-16">
              <p class="font-mono text-sm tabular-nums text-(--color-text-dark)">
                {s.step}
              </p>
              <h3 class="mt-3 font-display text-2xl leading-[1.12] tracking-[-0.02em] text-(--color-text) md:text-3xl">
                {s.title}
              </h3>
              <p class="mt-3 max-w-[65ch] text-base leading-relaxed text-(--color-text-dark)">
                {s.description}
              </p>
            </div>
          </li>
        );
      })
    }
  </ol>
</section>
