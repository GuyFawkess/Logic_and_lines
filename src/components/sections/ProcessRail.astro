---
// Proceso (F2): tarjetas de paso en clave v4 (feedback del usuario: prefiere
// "las tarjetas de antes" de main, sin daisyUI ni glass). Iconos extraídos de
// main:src/components/Proceso.astro. Línea maestra (F3-v2, dirección C): SVG
// con 3 segmentos + 4 nodos ámbar que une las tarjetas en lg, dirigida por el
// driver único de line-system.ts. El markup parte del estado FINAL (línea
// completa, nodos visibles): es el JS quien la "prepara" para animar — sin JS
// todo visible (regla de oro). En móvil (<lg) no hay línea: entrada simple de
// tarjetas (decisión documentada en line-system.ts). Los nodos llevan
// data-node y los segmentos data-line-segment para el sistema de línea.
import { useTranslations } from "../../i18n/utils";

interface Props {
  currentLang: "es" | "en";
}

const { currentLang } = Astro.props;
const t = useTranslations(currentLang);
const steps = t.process.steps as Array<{
  step: string;
  title: string;
  description: string;
  items: string[];
}>;

// Paths de icono (24px, stroke) tomados de main:src/components/Proceso.astro
const stepIcons = [
  "M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z", // Chat bubble
  "M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z", // Star
  "M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z", // Cog
  "M13 7h8m0 0v8m0-8l-8 8-4-4-6 6", // Trending up graph
];
---

<!-- Capitulo claro (F4-t1): fondo full-bleed --color-bg-chapter (#223B47,
     corte recto, sin rounded). El section pasa a ser la banda a sangre y el
     max-w/px baja a un div interior: mismo layout interno, cero cambios de
     diseno. pb simetrico al pt del h2 (ritmo Thesis: pb-24/lg:pb-32).
     Contrastes calculados (WCAG): text 11.04:1, text-dark 5.12:1 y primary
     5.46:1 sobre el capitulo (todos >= 4.5) -> tokens de texto SIN cambios.
     Tarjetas (--color-card) se mantienen sobre el capitulo (step 1.32:1,
     mejor que el 1.14:1 de hoy sobre bg) y la hairline compuesta da 1.50:1, identica
     en caracter a la de bg (1.49:1): bordes intactos. -->
<section id="proceso" class="bg-(--color-bg-chapter) pb-24 lg:pb-32">
  <div class="mx-auto w-full max-w-[1400px] px-6 lg:px-10">
  <h2
    class="pt-24 font-display text-[clamp(2rem,4.5vw,3.5rem)] leading-[1.12] tracking-[-0.04em] text-(--color-text) lg:pt-32"
    data-reveal="lines"
  >
    {t.process.title}
  </h2>
  <p class="mt-4 max-w-2xl text-base leading-relaxed text-(--color-text-dark) lg:text-lg">
    {t.process.subtitle}
  </p>

  <!-- Línea maestra (F3-v2): 3 segmentos + 4 nodos en un SVG anclado al layout
       (solo lg; overflow-visible para que el anillo del pop no se recorte).
       Geometría idéntica a la hairline F1 que sustituye: caja de 10px (h-2.5),
       nodos r=5 en 12.5/37.5/62.5/87.5%, línea por el centro (y=50%). -->
  <svg
    class="mt-14 hidden h-2.5 w-full overflow-visible lg:block"
    aria-hidden="true"
    data-line-rail
  >
    <line
      data-line-segment
      x1="12.5%"
      y1="50%"
      x2="37.5%"
      y2="50%"
      class="stroke-(--color-primary)"
      stroke-width="1.5"
      stroke-linecap="round"></line>
    <line
      data-line-segment
      x1="37.5%"
      y1="50%"
      x2="62.5%"
      y2="50%"
      class="stroke-(--color-primary)"
      stroke-width="1.5"
      stroke-linecap="round"></line>
    <line
      data-line-segment
      x1="62.5%"
      y1="50%"
      x2="87.5%"
      y2="50%"
      class="stroke-(--color-primary)"
      stroke-width="1.5"
      stroke-linecap="round"></line>
    <circle data-node cx="12.5%" cy="50%" r="5" class="fill-(--color-primary)"></circle>
    <circle data-node cx="37.5%" cy="50%" r="5" class="fill-(--color-primary)"></circle>
    <circle data-node cx="62.5%" cy="50%" r="5" class="fill-(--color-primary)"></circle>
    <circle data-node cx="87.5%" cy="50%" r="5" class="fill-(--color-primary)"></circle>
  </svg>

  <div class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-2 lg:mt-8 lg:grid-cols-4" data-rail-grid>
    {
      steps.map((s, i) => (
        <article class="flex h-full flex-col rounded-xl border border-(--color-hairline) bg-(--color-card) p-6 transition-colors duration-300 hover:border-(--color-primary)/60">
          <div class="flex items-start justify-between">
            <svg
              class="h-6 w-6 text-(--color-primary)"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d={stepIcons[i]} />
            </svg>
            <span class="font-display text-3xl tabular-nums text-(--color-primary) opacity-80">
              {s.step}
            </span>
          </div>
          <h3 class="mt-4 font-display text-xl leading-[1.15] tracking-[-0.02em] text-(--color-text) lg:text-2xl">
            {s.title}
          </h3>
          <p class="mt-3 text-base leading-relaxed text-(--color-text-dark)">
            {s.description}
          </p>
          <ul class="mt-5 space-y-2 border-t border-(--color-hairline) pt-4">
            {s.items.map((item) => (
              <li class="flex items-start gap-2.5 text-sm text-(--color-text-dark)">
                <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-(--color-primary)" aria-hidden="true" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>

  <p class="mt-12 max-w-3xl text-lg italic text-(--color-text-dark)">
    {t.process.quote}
  </p>
  </div>
</section>
