---
// System note (image roles): deliberate variety inside a range, not a uniform
// grid. Full-width 21:9 is the single compositional peak, wide column images
// hold about 40 percent of the content width, square accents about a third of
// it. Keep the roles distinct, do not equalize image sizes across rows.
// Índice editorial de servicios (F1): filas con composición ASIMÉTRICA variada
// (nada de grid de cards ni zigzag mecánico). Cada entrada: hairline superior,
// índice mono tabular real, título Sentient, especificación mono, descripción
// ≤65ch, enlace a la ficha e imagen webp con dimensiones intrínsecas reales.
import { getCollection } from "astro:content";
import { useTranslations } from "../../i18n/utils";

interface Props {
  currentLang: "es" | "en";
}

const { currentLang } = Astro.props;
const t = useTranslations(currentLang);
const isEn = currentLang === "en";

const services = (await getCollection("services")).sort(
  (a, b) => (a.data.sortOrder || 999) - (b.data.sortOrder || 999),
);

// Dimensiones intrínsecas reales de las webp (cabecera RIFF/VP8X/VP8)
const imageDims: Record<string, { w: number; h: number }> = {
  "/logic-map/logic-map-2.webp": { w: 1184, h: 864 },
  "/sales-line/funnels-provisional.webp": { w: 1024, h: 768 },
  "/flow-line/flow-line-2.webp": { w: 1024, h: 768 },
  "/logic-agent/logic-agents-2.webp": { w: 1032, h: 755 },
  "/logic-support/logic-support-3.webp": { w: 1024, h: 1024 },
  "/smarthost/smarthost-2.webp": { w: 1024, h: 1024 },
};

// Patrones de composición por fila: tamaño, posición y recorte cambian a propósito
const rowLayouts = [
  // 0: imagen derecha media
  {
    gridClass: "md:grid-cols-12",
    imgWrap: "md:col-span-5 md:col-start-8 md:row-start-1",
    imgClass: "aspect-[1184/864]",
    textWrap: "md:col-span-6 md:col-start-1 md:row-start-1",
  },
  // 1: imagen izquierda pequeña y descolgada
  {
    gridClass: "md:grid-cols-12",
    imgWrap: "md:col-span-4 md:col-start-1 md:row-start-1 md:mt-12",
    imgClass: "aspect-[4/3]",
    textWrap: "md:col-span-7 md:col-start-6 md:row-start-1",
  },
  // 2: fila full-width (estructura propia, ver template)
  {
    gridClass: "md:grid-cols-12",
    imgWrap: "",
    imgClass: "aspect-[21/9]",
    textWrap: "",
  },
  // 3: imagen derecha, más estrecha y alineada arriba
  {
    gridClass: "md:grid-cols-12",
    imgWrap: "md:col-span-5 md:col-start-7 md:row-start-1",
    imgClass: "aspect-[3/2]",
    textWrap: "md:col-span-5 md:col-start-1 md:row-start-1",
  },
  // 4: acento cuadrado a la izquierda, 34% del ancho de contenido
  {
    gridClass: "md:grid-cols-[34%_minmax(0,1fr)]",
    imgWrap: "md:col-start-1 md:row-start-1",
    imgClass: "aspect-square",
    textWrap: "md:col-start-2 md:row-start-1",
  },
  // 5: fila compacta, acento cuadrado a la derecha, 34% del ancho de contenido
  {
    gridClass: "md:grid-cols-[minmax(0,1fr)_34%]",
    imgWrap: "md:col-start-2 md:row-start-1",
    imgClass: "aspect-square",
    textWrap: "md:col-start-1 md:row-start-1",
  },
];

const pad = (i: number) => (i === 5 ? "py-10 lg:py-12" : "py-12 lg:py-16");
const num = (i: number) => String(i + 1).padStart(2, "0");
---

<section id="servicios" class="mx-auto w-full max-w-[1400px] px-6 lg:px-10">
  <h2
    class="pt-24 font-display text-[clamp(2rem,4.5vw,3.5rem)] leading-[1.12] tracking-[-0.04em] text-(--color-text) lg:pt-32"
  >
    {t.services.title}
  </h2>

  <div class="mt-14">
    {
      services.map((entry, i) => {
        const layout = rowLayouts[i] ?? rowLayouts[rowLayouts.length - 1];
        const dims = imageDims[entry.data.img] ?? { w: 1024, h: 768 };
        const title = isEn && entry.data.title_en ? entry.data.title_en : entry.data.title;
        const spec =
          isEn && entry.data.specification_en
            ? entry.data.specification_en
            : entry.data.specification;
        const description =
          isEn && entry.data.description_en
            ? entry.data.description_en
            : entry.data.description;
        const href = isEn ? `/en/service/${entry.slug}` : `/service/${entry.slug}`;

        return i === 2 ? (
          // Fila full-width: imagen panorámica a sangre de la caja + texto apilado
          <article class={`border-t border-(--color-hairline) ${pad(i)}`}>
            <figure class="w-full overflow-hidden">
              <img
                src={entry.data.img}
                width={dims.w}
                height={dims.h}
                loading="lazy"
                decoding="async"
                alt={`${title}. ${spec ?? ""}`}
                class={`${layout.imgClass} w-full object-cover`}
              />
            </figure>
            <div class="mt-10 md:grid md:grid-cols-12 md:gap-10">
              <div class="md:col-span-7">
                <p class="font-mono text-sm tabular-nums text-(--color-text-dark)">
                  {num(i)}
                </p>
                <h3 class="mt-3 font-display text-[clamp(1.875rem,3vw,2.75rem)] font-bold leading-[1.12] tracking-[-0.02em] text-(--color-text)">
                  {title}
                </h3>
              </div>
              <div class="md:col-span-5 md:col-start-8">
                {spec && (
                  <p class="mt-4 font-mono text-xs leading-relaxed text-(--color-text-dark) md:mt-2">
                    {spec}
                  </p>
                )}
                <p class="mt-4 max-w-[65ch] text-base leading-relaxed text-(--color-text-dark)">
                  {description}
                </p>
                <a
                  href={href}
                  class="mt-6 inline-flex min-h-11 items-center text-sm font-medium text-(--color-text) underline underline-offset-4 transition-colors duration-200 hover:text-(--color-primary)"
                  data-gtm-event="service_click"
                  data-gtm-location="services_index"
                  data-gtm-label={entry.slug}
                >
                  <span>{t.services.view}</span>
                </a>
              </div>
            </div>
          </article>
        ) : (
          // Filas asimétricas: imagen y texto en columnas de anchos distintos
          <article
            class={`grid grid-cols-1 gap-8 border-t border-(--color-hairline) ${pad(i)} ${layout.gridClass} md:gap-10`}
          >
            <div class={layout.imgWrap}>
              <figure class="w-full overflow-hidden">
                <img
                  src={entry.data.img}
                  width={dims.w}
                  height={dims.h}
                  loading="lazy"
                  decoding="async"
                  alt={`${title}. ${spec ?? ""}`}
                  class={`${layout.imgClass} w-full object-cover`}
                />
              </figure>
            </div>
            <div class={layout.textWrap}>
              <p class="font-mono text-sm tabular-nums text-(--color-text-dark)">
                {num(i)}
              </p>
              <h3 class="mt-3 font-display text-[clamp(1.875rem,3vw,2.75rem)] font-bold leading-[1.12] tracking-[-0.02em] text-(--color-text)">
                {title}
              </h3>
              {spec && (
                <p class="mt-3 font-mono text-xs leading-relaxed text-(--color-text-dark)">
                  {spec}
                </p>
              )}
              <p class="mt-4 max-w-[65ch] text-base leading-relaxed text-(--color-text-dark)">
                {description}
              </p>
              <a
                href={href}
                class="mt-6 inline-flex min-h-11 items-center text-sm font-medium text-(--color-text) underline underline-offset-4 transition-colors duration-200 hover:text-(--color-primary)"
                data-gtm-event="service_click"
                data-gtm-location="services_index"
                data-gtm-label={entry.slug}
              >
                <span>{t.services.view}</span>
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>
