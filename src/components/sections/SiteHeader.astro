---
// Cabecera v4 (F1): una línea desktop, sticky, con burger a pantalla completa en móvil.
// Sin motion avanzado: solo transiciones CSS de color ≤200ms.
import LanguageSwitcher from "../LanguageSwitcher.astro";
import { useTranslations } from "../../i18n/utils";

interface Props {
  currentLang: "es" | "en";
  // Prefijo de la home para las anclas de sección. En la home se deja vacío
  // (href="#servicios"); las subpáginas pasan "/" o "/en/" para que las
  // anclas apunten a las secciones de la home. No cambia el render del home.
  homePrefix?: string;
}

const { currentLang, homePrefix = "" } = Astro.props;
const t = useTranslations(currentLang);
const baseUrl = currentLang === "en" ? "/en/" : "/";
const contactHref = currentLang === "en" ? "/en/contact" : "/contact";

// Anclas de la home nueva (ids de las secciones F1)
const navLinks = [
  { href: `${homePrefix}#servicios`, label: t.nav.services },
  { href: `${homePrefix}#proceso`, label: t.nav.process },
  { href: `${homePrefix}#razones`, label: t.nav.reason },
  { href: `${homePrefix}#faq`, label: t.nav.faq },
];

const menuLabel = currentLang === "en" ? "Open menu" : "Abrir menú";
const closeLabel = currentLang === "en" ? "Close menu" : "Cerrar menú";
---

<header
  class="sticky top-0 z-50 w-full border-b border-(--color-hairline) bg-(--color-bg)"
>
  <nav
    class="mx-auto flex h-[72px] w-full max-w-[1400px] items-center justify-between gap-6 px-6 lg:px-10"
    aria-label={currentLang === "en" ? "Main" : "Principal"}
  >
    <!-- Marca: símbolo + wordmark -->
    <a
      href={baseUrl}
      class="flex min-h-11 shrink-0 items-center gap-3 lg:min-h-0"
      aria-label="Logic & Lines"
    >
      <img
        src="/logoSolo.svg"
        width="60"
        height="60"
        alt=""
        loading="lazy"
        class="h-8 w-8"
        decoding="async"
      />
      <span class="font-display text-lg leading-none text-(--color-text)"
        >Logic &amp; Lines</span
      >
    </a>

    <!-- Navegación desktop -->
    <ul class="hidden items-center gap-8 lg:flex">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="inline-flex h-11 items-center text-sm text-(--color-text) transition-colors duration-200 hover:text-(--color-primary)"
            >
              <span>{link.label}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="hidden shrink-0 items-center gap-4 lg:flex">
      <LanguageSwitcher currentLang={currentLang} />
      <a
        href={contactHref}
        class="inline-flex h-11 items-center justify-center whitespace-nowrap bg-(--color-primary) px-5 text-sm font-medium text-(--color-bg) transition-colors duration-200 hover:bg-(--color-primary-hover) active:translate-y-px"
        data-gtm-event="cta_click"
        data-gtm-location="header_desktop"
        data-gtm-label="schedule_call"
      >
        {t.buttons.book}
      </a>
    </div>

    <!-- Burger (móvil y tablet) -->
    <button
      type="button"
      id="nav-toggle"
      class="inline-flex h-11 w-11 items-center justify-center lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-panel"
      aria-label={menuLabel}
    >
      <svg
        class="h-5 w-5 text-(--color-text)"
        viewBox="0 0 20 20"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
      >
        <path d="M2 5h16M2 10h16M2 15h16"></path>
      </svg>
    </button>
  </nav>

  <!-- Panel móvil a pantalla completa (se muestra/oculta con hidden: sin reveal por CSS) -->
  <div
    id="mobile-panel"
    hidden
    class="fixed inset-0 z-[70] flex flex-col bg-(--color-bg) lg:hidden"
  >
    <div
      class="mx-auto flex h-[72px] w-full max-w-[1400px] items-center justify-between px-6"
    >
      <a
        href={baseUrl}
        class="flex min-h-11 items-center gap-3"
        aria-label="Logic & Lines"
      >
        <img
          src="/logoSolo.svg"
          width="60"
          height="60"
          alt=""
          loading="lazy"
          class="h-8 w-8"
          decoding="async"
        />
        <span class="font-display text-lg leading-none text-(--color-text)"
          >Logic &amp; Lines</span
        >
      </a>
      <button
        type="button"
        id="nav-close"
        class="inline-flex h-11 w-11 items-center justify-center"
        aria-label={closeLabel}
      >
        <svg
          class="h-5 w-5 text-(--color-text)"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <path d="M4 4l12 12M16 4L4 16"></path>
        </svg>
      </button>
    </div>

    <nav
      class="mx-auto flex w-full max-w-[1400px] flex-1 flex-col gap-1 px-6 pb-12"
      aria-label={currentLang === "en" ? "Mobile" : "Móvil"}
    >
      {
        navLinks.map((link, i) => (
          <a
            href={link.href}
            style={`--i:${i}`}
            class="mobile-link inline-flex min-h-11 items-center border-t border-(--color-hairline) py-4 font-display text-2xl text-(--color-text) transition-colors duration-200 hover:text-(--color-primary)"
          >
            <span>{link.label}</span>
          </a>
        ))
      }
      <a
        href={contactHref}
        style={`--i:${navLinks.length}`}
        class="mobile-link mt-8 inline-flex h-12 items-center justify-center whitespace-nowrap bg-(--color-primary) px-6 text-base font-medium text-(--color-bg) transition-colors duration-200 hover:bg-(--color-primary-hover) active:translate-y-px"
        data-gtm-event="cta_click"
        data-gtm-location="header_mobile"
        data-gtm-label="schedule_call"
      >
        {t.buttons.book}
      </a>
      <div class="mobile-link mt-6" style={`--i:${navLinks.length + 1}`}>
        <LanguageSwitcher currentLang={currentLang} />
      </div>
    </nav>
  </div>
</header>

<style>
  /* Animación del panel móvil: solo opacity/transform. El panel se muestra con
     [hidden]=false y la clase .is-open (añadida en el frame siguiente) lanza la
     transición; al cerrar se quita .is-open y, al terminar, se pone hidden.
     Easing = EASE_REVEAL (tokens.ts). Sin JS el panel no se abre (ya era así). */
  /* Despliegue hacia abajo (clip-path) al abrir y MISMO recorrido invertido al
     cerrar: se pliega de abajo hacia arriba. Los enlaces se desvanecen rápido
     al cerrar para que no se corten con el borde que sube. */
  #mobile-panel {
    clip-path: inset(0 0 100% 0);
    pointer-events: none;
    transition: clip-path 380ms cubic-bezier(0.65, 0, 0.35, 1);
  }
  #mobile-panel.is-open {
    clip-path: inset(0 0 0 0);
    pointer-events: auto;
    transition: clip-path 420ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  #mobile-panel .mobile-link {
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 150ms ease-out,
      transform 150ms ease-out,
      color 200ms;
  }
  #mobile-panel.is-open .mobile-link {
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 320ms cubic-bezier(0.16, 1, 0.3, 1) calc(90ms + var(--i, 0) * 35ms),
      transform 320ms cubic-bezier(0.16, 1, 0.3, 1) calc(90ms + var(--i, 0) * 35ms),
      color 200ms;
  }
  #mobile-panel #nav-close svg {
    opacity: 0;
    transform: rotate(-90deg);
    transition:
      opacity 150ms ease-out,
      transform 150ms ease-out;
  }
  #mobile-panel.is-open #nav-close svg {
    opacity: 1;
    transform: rotate(0);
    transition:
      opacity 280ms cubic-bezier(0.16, 1, 0.3, 1) 60ms,
      transform 320ms cubic-bezier(0.16, 1, 0.3, 1) 60ms;
  }
  @media (prefers-reduced-motion: reduce) {
    #mobile-panel,
    #mobile-panel.is-open {
      clip-path: none;
    }
    #mobile-panel,
    #mobile-panel.is-open,
    #mobile-panel .mobile-link,
    #mobile-panel.is-open .mobile-link,
    #mobile-panel #nav-close svg,
    #mobile-panel.is-open #nav-close svg {
      transition: none;
      transform: none;
    }
  }
</style>

<script>
  // Panel móvil: toggle accesible (aria-expanded + hidden), Escape para cerrar
  // y cierre al pulsar un ancla. Entrada/salida por CSS (.is-open); hidden se
  // aplica al terminar la salida (transitionend + timeout de seguridad).
  function setupMobileNav() {
    const toggle = document.getElementById("nav-toggle");
    const closeBtn = document.getElementById("nav-close");
    const panel = document.getElementById("mobile-panel");
    if (!toggle || !closeBtn || !panel) return;
    if (toggle.dataset.bound === "true") return;
    toggle.dataset.bound = "true";

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    let hideTimer: number | undefined;
    const finishHide = () => {
      window.clearTimeout(hideTimer);
      if (!panel.classList.contains("is-open")) panel.hidden = true;
    };
    const isOpen = () => toggle.getAttribute("aria-expanded") === "true";

    const open = () => {
      window.clearTimeout(hideTimer);
      panel.hidden = false;
      toggle.setAttribute("aria-expanded", "true");
      closeBtn.focus({ preventScroll: true });
      if (reduce.matches) {
        panel.classList.add("is-open");
        return;
      }
      void panel.offsetHeight; // fija el estado inicial antes de transicionar
      requestAnimationFrame(() => panel.classList.add("is-open"));
    };
    const close = () => {
      toggle.setAttribute("aria-expanded", "false");
      panel.classList.remove("is-open");
      toggle.focus({ preventScroll: true });
      if (reduce.matches) {
        panel.hidden = true;
        return;
      }
      window.clearTimeout(hideTimer);
      hideTimer = window.setTimeout(finishHide, 440);
    };

    toggle.addEventListener("click", () => {
      if (isOpen()) close();
      else open();
    });
    closeBtn.addEventListener("click", close);
    panel.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", close);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isOpen()) close();
    });
  }

  setupMobileNav();
  document.addEventListener("astro:page-load", setupMobileNav);
</script>
