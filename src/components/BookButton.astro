---
import { useTranslations } from "../i18n/utils";

const {
  currentLang = "es",
  text,
  class: className = "",
  buttonClass = "",
  gtmLocation = "book_button",
} = Astro.props;
const t = useTranslations(currentLang);
const baseUrl = currentLang === "en" ? "/en/" : "/";
const displayText = text || t.buttons.book;
---

<a
  href={`${baseUrl}#booking`}
  class={`flex items-center justify-center px-8 py-4 text-base font-medium rounded-xl text-(--color-bg) bg-(--color-primary) hover:bg-(--color-primary-hover) transition-all duration-300 shadow-[0_0_20px_rgba(235,170,0,0.3)] hover:shadow-[0_0_30px_rgba(235,170,0,0.5)] transform hover:-translate-y-1 whitespace-nowrap min-w-[220px] my-8 w-fit mx-auto ${className} ${buttonClass}`}
  data-gtm-event="cta_click"
  data-gtm-location={gtmLocation}
  data-gtm-label="schedule_call"
>
  {displayText}
</a>

