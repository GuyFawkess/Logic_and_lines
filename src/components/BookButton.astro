---
// CTA de booking (gramática C): botón ámbar plano (radio 0, sin glow), una sola
// línea. Conserva el destino (home + #booking) y los atributos GTM del v1.
import { useTranslations } from "../i18n/utils";

const {
  currentLang = "es",
  text,
  class: className = "",
  buttonClass = "",
  gtmLocation = "book_button",
} = Astro.props;
const t = useTranslations(currentLang);
const baseUrl = currentLang === "en" ? "/en/" : "/";
const displayText = text || t.buttons.book;
---

<a
  href={`${baseUrl}#booking`}
  class={`inline-flex h-12 items-center justify-center whitespace-nowrap bg-(--color-primary) px-6 text-sm font-medium text-(--color-bg) transition-colors duration-200 hover:bg-(--color-primary-hover) active:translate-y-px ${className} ${buttonClass}`}
  data-gtm-event="cta_click"
  data-gtm-location={gtmLocation}
  data-gtm-label="schedule_call"
>
  {displayText}
</a>
